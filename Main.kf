import publab.machine
import publab.assembler
import publab.app
import publab.ui

// PubLab — the laboratory window.
//
// This file is deliberately thin: it builds the widget tree, wires the
// controls to publab.ui's controller, and copies strings produced by
// publab.ui's presenter into labels. It contains no machine logic, no
// formatting rules and no translatable sentence — those live in packages that
// the test suite can reach, because widgets only render on the JS target.
//
// Run it:   kof run Main.kf --target js
// Build it: kof build . --target js --output build/ui

// The widget handles the refresh needs to reach. Kof widget handles are Ints
// and a lambda captures a read-only snapshot of its environment, so the
// handles live in static fields — the snapshot of a handle still points at
// the real widget.
class Ui {
    static Window window = Window("PubLab")
    static Textarea editor = Textarea("")
    static Select machines = Select(listOf("PubVM-8"))
    static Select examples = Select(listOf("overflow.pasm"))
    static Select languages = Select(listOf("English"))

    static Label slogan = Label("")
    static Label machineSummary = Label("")
    static Label status = Label("")
    static Label current = Label("")
    static Label message = Label("")
    static Label flags = Label("")
    static Label output = Label("")
    static Label diagnostics = Label("")

    static Label regA = Label("")
    static Label regB = Label("")
    static Label regC = Label("")
    static Label regD = Label("")
    // X and Y: Advanced Mode, phase 8 stage A.
    static Label regX = Label("")
    static Label regY = Label("")

    static Label sourceTitle = Label("")
    static Label registersTitle = Label("")
    static Label flagsTitle = Label("")
    static Label outputTitle = Label("")
    static Label diagnosticsTitle = Label("")
    static Label machineTitle = Label("")
    static Label exampleTitle = Label("")
    static Label languageTitle = Label("")

    // Debugger (phase 6). The memory dump and the change list are one label
    // each: the generated page renders labels with `white-space: pre-wrap`, so
    // a multi-line string is a multi-line panel.
    static Label sourceLine = Label("")
    static Label memoryTitle = Label("")
    static Label memoryLegend = Label("")
    static Label memoryDump = Label("")
    static Label changesTitle = Label("")
    static Label changes = Label("")
    static Label viewTitle = Label("")
    static Select memoryModes = Select(listOf("HEX"))

    // The stack (Advanced Mode, phase 8 stage A): SP/FP and the words PUSH
    // has written, anchored at SP instead of PC.
    static Label stackTitle = Label("")
    static Label stackPointer = Label("")
    static Label stackDump = Label("")
    static Label stackNote = Label("")

    // The educational layer (phase 7): plain-language explanation of the last
    // Step or Run, in the panel's own label.
    static Label explainTitle = Label("")
    static Label explanation = Label("")

    static Button assembleButton = Button("", () -> {})
    static Button resetButton = Button("", () -> {})
    static Button stepButton = Button("", () -> {})
    static Button runButton = Button("", () -> {})

    // Phase 11 stage A: the 8051 and Cortex-M3 tabs. Their own self-contained
    // widget set, mirroring PubVM's shape but simpler — one multi-line label
    // for registers instead of one per register, since each architecture has
    // a different register count (docs/architecture-comparison.md).
    static Label lab8051Title = Label("")
    static Textarea editor8051 = Textarea("")
    static Button assemble8051Button = Button("", () -> {})
    static Button reset8051Button = Button("", () -> {})
    static Button step8051Button = Button("", () -> {})
    static Button run8051Button = Button("", () -> {})
    static Label message8051 = Label("")
    static Label status8051 = Label("")
    static Label current8051 = Label("")
    static Label registers8051Title = Label("")
    static Label registers8051 = Label("")
    static Label flags8051Title = Label("")
    static Label flags8051 = Label("")
    static Label output8051Title = Label("")
    static Label output8051 = Label("")
    static Label diagnostics8051Title = Label("")
    static Label diagnostics8051 = Label("")
    static Label explain8051Title = Label("")
    static Label explanation8051 = Label("")

    static Label labM3Title = Label("")
    static Textarea editorM3 = Textarea("")
    static Button assembleM3Button = Button("", () -> {})
    static Button resetM3Button = Button("", () -> {})
    static Button stepM3Button = Button("", () -> {})
    static Button runM3Button = Button("", () -> {})
    static Label messageM3 = Label("")
    static Label statusM3 = Label("")
    static Label currentM3 = Label("")
    static Label registersM3Title = Label("")
    static Label registersM3 = Label("")
    static Label flagsM3Title = Label("")
    static Label flagsM3 = Label("")
    static Label outputM3Title = Label("")
    static Label outputM3 = Label("")
    static Label diagnosticsM3Title = Label("")
    static Label diagnosticsM3 = Label("")
    static Label explainM3Title = Label("")
    static Label explanationM3 = Label("")

    // Phase 11 stage B: the comparison view. Three real, independently
    // assembled programs run Step-synchronized — see publab/ui/Compare.kf.
    static Label compareTitle = Label("")
    static Select compareSets = Select(listOf("Overflow and carry"))
    static Label compareSetLabel = Label("")
    static Label compareDescription = Label("")
    static Button compareAssembleButton = Button("", () -> {})
    static Button compareStepButton = Button("", () -> {})
    static Label compareMessage = Label("")

    static Label comparePubvmLabel = Label("")
    static Label comparePubvmStatus = Label("")
    static Label comparePubvmOutput = Label("")
    static Label comparePubvmExplain = Label("")

    static Label compare8051Label = Label("")
    static Label compare8051Status = Label("")
    static Label compare8051Output = Label("")
    static Label compare8051Explain = Label("")

    static Label compareM3Label = Label("")
    static Label compareM3Status = Label("")
    static Label compareM3Output = Label("")
    static Label compareM3Explain = Label("")
}

Color textColor() { return Color(230, 230, 242) }
Color focusColor() { return Color(125, 211, 252) }
Color successColor() { return Color(52, 211, 153) }
Color dataColor() { return Color(251, 191, 36) }
Color errorColor() { return Color(248, 113, 113) }
Color dimColor() { return Color(110, 120, 150) }

Label sectionTitle(Label label) {
    label.fontSize = 11
    label.bold = true
    label.color = dimColor()
    return label
}

// Every string in the window comes from the real machine state, through the
// presenter. Called after every control.
void refresh() {
    val state = labState()
    val language = labLanguage()

    val previous = labPreviousState()

    Ui.machineSummary.text = machineSummary(state, language)
    Ui.status.text = statusText(state, language)
    Ui.current.text = currentInstructionLine(state, language)
    Ui.sourceLine.text = labSourceLine()
    Ui.message.text = labMessage()
    Ui.output.text = outputText(state, language)

    // Registers and flags carry a one-character marker for what the last
    // instruction changed, so the columns never move.
    Ui.flags.text = flagsTextWithChanges(previous, state)
    val registers = registerLinesWithChanges(previous, state)
    Ui.regA.text = registers.get(0)
    Ui.regB.text = registers.get(1)
    Ui.regC.text = registers.get(2)
    Ui.regD.text = registers.get(3)
    Ui.regX.text = registers.get(4)
    Ui.regY.text = registers.get(5)

    // The memory dump, from the real memory, following PC.
    val base = labMemoryBase()
    val window = labMemoryWindow()
    val previousWindow = labPreviousMemoryWindow()
    Ui.memoryDump.text = memoryHeader(labMemoryMode(), state.addressBits()) + "\n"
        + joinLines(memoryRows(window, base, previousWindow, state.pc(),
            labMemoryMode(), state.addressBits()))
    Ui.memoryLegend.text = memoryLegend(language)
    Ui.changes.text = joinLines(changeLines(previous, state, previousWindow, window,
        base, language))
    Ui.explanation.text = labExplanation()

    // The stack: SP/FP plus the words PUSH has written, read straight from
    // the real memory through SP.
    Ui.stackPointer.text = stackPointerText(state)
    val stackWindow = labStackWindow()
    if (stackWindow.size == 0) {
        Ui.stackDump.text = stackEmptyMessage(language)
    } else {
        Ui.stackDump.text = memoryHeader(labMemoryMode(), state.addressBits()) + "\n"
            + joinLines(stackRows(stackWindow, state.sp(), labMemoryMode(), state.addressBits()))
    }

    if (labDiagnostics().length > 0) {
        Ui.diagnostics.text = labDiagnostics()
    } else {
        Ui.diagnostics.text = emptyDiagnosticsMessage(language)
    }

    val status = statusName(state.status())
    if (status == "ERROR") {
        Ui.status.color = errorColor()
    } else if (status == "HALTED") {
        Ui.status.color = successColor()
    } else {
        Ui.status.color = focusColor()
    }
}

// Phase 11 stage A: the 8051 tab's own refresh, independent of PubVM's —
// same rule as Lab8051.kf itself (docs/architecture-comparison.md).
void refresh8051() {
    val language = labLanguage()
    val state = lab8051State()
    Ui.status8051.text = statusText8051(state, language)
    Ui.current8051.text = currentInstructionLine8051(state, language)
    Ui.message8051.text = lab8051Message()
    Ui.registers8051.text = joinLines(registerLines8051(state))
    Ui.flags8051.text = flagsText8051(state)
    Ui.output8051.text = outputText8051(state, language)
    Ui.explanation8051.text = lab8051Explanation(language)
    if (lab8051Diagnostics().length > 0) {
        Ui.diagnostics8051.text = lab8051Diagnostics()
    } else {
        Ui.diagnostics8051.text = emptyDiagnosticsMessage(language)
    }
    val status = statusName(state.status())
    if (status == "ERROR") { Ui.status8051.color = errorColor() }
    else if (status == "HALTED") { Ui.status8051.color = successColor() }
    else { Ui.status8051.color = focusColor() }
}

void refreshM3() {
    val language = labLanguage()
    val state = labM3State()
    Ui.statusM3.text = statusTextM3(state, language)
    Ui.currentM3.text = currentInstructionLineM3(state, language)
    Ui.messageM3.text = labM3Message()
    Ui.registersM3.text = joinLines(registerLinesM3(state))
    Ui.flagsM3.text = flagsTextM3(state)
    Ui.outputM3.text = outputTextM3(state, language)
    Ui.explanationM3.text = labM3Explanation(language)
    if (labM3Diagnostics().length > 0) {
        Ui.diagnosticsM3.text = labM3Diagnostics()
    } else {
        Ui.diagnosticsM3.text = emptyDiagnosticsMessage(language)
    }
    val status = statusName(state.status())
    if (status == "ERROR") { Ui.statusM3.color = errorColor() }
    else if (status == "HALTED") { Ui.statusM3.color = successColor() }
    else { Ui.statusM3.color = focusColor() }
}

void relabel8051() {
    val language = labLanguage()
    Ui.lab8051Title.text = lab8051Title(language)
    Ui.assemble8051Button.text = assembleButton(language)
    Ui.reset8051Button.text = resetButton(language)
    Ui.step8051Button.text = stepButton(language)
    Ui.run8051Button.text = runButton(language)
    Ui.registers8051Title.text = registersTitle(language)
    Ui.flags8051Title.text = flagsTitle(language)
    Ui.explain8051Title.text = explainTitle(language)
    Ui.output8051Title.text = outputTitle(language)
    Ui.diagnostics8051Title.text = diagnosticsTitle(language)
}

void relabelM3() {
    val language = labLanguage()
    Ui.labM3Title.text = labM3Title(language)
    Ui.assembleM3Button.text = assembleButton(language)
    Ui.resetM3Button.text = resetButton(language)
    Ui.stepM3Button.text = stepButton(language)
    Ui.runM3Button.text = runButton(language)
    Ui.registersM3Title.text = registersTitle(language)
    Ui.flagsM3Title.text = flagsTitle(language)
    Ui.explainM3Title.text = explainTitle(language)
    Ui.outputM3Title.text = outputTitle(language)
    Ui.diagnosticsM3Title.text = diagnosticsTitle(language)
}

// --- 8051 control handlers ---

void on8051Assemble() {
    lab8051Assemble(Ui.editor8051.text(), labLanguage())
    refresh8051()
}

void on8051Reset() {
    lab8051Reset(labLanguage())
    refresh8051()
}

void on8051Step() {
    lab8051Step(labLanguage())
    refresh8051()
}

void on8051Run() {
    lab8051Run(labLanguage())
    refresh8051()
}

// --- Cortex-M3 control handlers ---

void onM3Assemble() {
    labM3Assemble(Ui.editorM3.text(), labLanguage())
    refreshM3()
}

void onM3Reset() {
    labM3Reset(labLanguage())
    refreshM3()
}

void onM3Step() {
    labM3Step(labLanguage())
    refreshM3()
}

void onM3Run() {
    labM3Run(labLanguage())
    refreshM3()
}

// Phase 11 stage B: the comparison view's own refresh/relabel and handlers.
void refreshCompare() {
    val language = labLanguage()
    Ui.compareMessage.text = compareMessage()
    Ui.compareDescription.text = compareSetDescription(compareSelected(), language)

    val pubvmState = comparePubvmState()
    Ui.comparePubvmStatus.text = statusText(pubvmState, language)
    Ui.comparePubvmOutput.text = outputText(pubvmState, language)
    Ui.comparePubvmExplain.text = comparePubvmExplanation(language)

    val m8051State = compareM8051State()
    Ui.compare8051Status.text = statusText8051(m8051State, language)
    Ui.compare8051Output.text = outputText8051(m8051State, language)
    Ui.compare8051Explain.text = compareM8051Explanation(language)

    val m3State = compareM3State()
    Ui.compareM3Status.text = statusTextM3(m3State, language)
    Ui.compareM3Output.text = outputTextM3(m3State, language)
    Ui.compareM3Explain.text = compareM3Explanation(language)
}

// The set names themselves stay in English in the selector, the same way
// Ui.machines' and Ui.examples' own option text is never re-translated on a
// language change (relabel() only re-labels panel titles and buttons) — see
// main()'s build below. The language DOES reach the description text,
// status/output/explanation, refreshed through refreshCompare().
void relabelCompare() {
    val language = labLanguage()
    Ui.compareTitle.text = compareTitle(language)
    Ui.compareSetLabel.text = compareSetLabel(language)
    Ui.compareAssembleButton.text = assembleButton(language)
    Ui.compareStepButton.text = compareStepAllButton(language)
    Ui.comparePubvmLabel.text = comparePubvmLabel(language)
    Ui.compare8051Label.text = compare8051Label(language)
    Ui.compareM3Label.text = compareM3Label(language)
}

void onCompareSetChange() {
    compareSelect(Ui.compareSets.selected())
    refreshCompare()
}

void onCompareAssemble() {
    compareAssemble(labLanguage())
    refreshCompare()
}

void onCompareStep() {
    compareStepAll(labLanguage())
    refreshCompare()
}

// The labels that are not machine state: panel titles and control captions.
// Re-applied when the language changes.
void relabel() {
    val language = labLanguage()
    Ui.slogan.text = taglineIn(language) + "  ·  " + productSlogan()
    Ui.sourceTitle.text = sourceTitle(language)
    Ui.registersTitle.text = registersTitle(language)
    Ui.flagsTitle.text = flagsTitle(language)
    Ui.outputTitle.text = outputTitle(language)
    Ui.diagnosticsTitle.text = diagnosticsTitle(language)
    Ui.machineTitle.text = machineTitle(language)
    Ui.exampleTitle.text = exampleTitle(language)
    Ui.languageTitle.text = languageTitle(language)
    Ui.assembleButton.text = assembleButton(language)
    Ui.resetButton.text = resetButton(language)
    Ui.stepButton.text = stepButton(language)
    Ui.runButton.text = runButton(language)
    Ui.memoryTitle.text = memoryTitle(language)
    Ui.changesTitle.text = changesTitle(language)
    Ui.viewTitle.text = viewTitle(language)
    Ui.stackTitle.text = stackTitle(language)
    Ui.stackNote.text = stackNote(language)
    Ui.explainTitle.text = explainTitle(language)
}

// --- control handlers ---
//
// Every lambda body is a single call to one of these. A widget bind
// (`label.text = ...`) written INSIDE a lambda makes the JVM backend emit a
// putfield against the widget type while the handle is an int, which fails
// bytecode verification at class load — see notes/kof-compiler-findings.md,
// D-3. Keeping handler bodies in named functions also keeps the wiring
// readable.

void onAssemble() {
    labAssemble(Ui.editor.text())
    refresh()
}

void onReset() {
    labReset()
    refresh()
}

void onStep() {
    labStep()
    refresh()
}

void onRun() {
    labRun()
    refresh()
}

void onMachineChange() {
    labSelectMachine(Ui.machines.selected())
    refresh()
}

void onExampleChange() {
    // setText, not `editor.text = …`: the `.text =` bind on a Textarea fails
    // bytecode verification on the JVM backend — see
    // notes/kof-compiler-findings.md, D-3. Label and Input are unaffected.
    Ui.editor.setText(labExampleSource(Ui.examples.selected()))
    refresh()
}

void onLanguageChange() {
    labSetLanguage(supportedLanguages().get(Ui.languages.selected()))
    relabel()
    refresh()
    relabel8051()
    refresh8051()
    relabelM3()
    refreshM3()
    relabelCompare()
    refreshCompare()
}

void onMemoryModeChange() {
    labSetMemoryMode(memoryModes().get(Ui.memoryModes.selected()))
    refresh()
}

main() {
    val panel = Style("background: #1A1E2E; color: #E6E6F2; padding: 14; border-radius: 6")
    val root = Style("background: #12151F; color: #E6E6F2; padding: 16; border-radius: 8")

    Ui.window = Window(productName() + " — " + productTagline())
    Ui.window.theme = Theme.dark()
    Ui.window.size(1120, 940)

    // --- header: product identity, from the brand module ---
    var title = Label(productName())
    title.fontSize = 24
    title.bold = true
    title.color = focusColor()
    Ui.slogan = Label("")
    Ui.slogan.fontSize = 12
    Ui.slogan.color = dimColor()
    var header = Row(listOf(title, Ui.slogan))

    // --- footer: the Kof attribution, plain ---
    // White text and nothing else: no underline, no accent colour, no hover
    // treatment. The attribution is a plain line in the footer, not a
    // decorated badge. Its text and URL come from the brand module, which
    // stays the single source for both.
    // The Style goes through a `val` on purpose. `setStyle(Style("…"))` with
    // the literal written inline as the argument compiles and runs, but the
    // style never reaches the runtime's registry, so it is a SILENT no-op —
    // see notes/kof-compiler-findings.md, D-4. Do not inline it back.
    val footer = Style("color: #ffffff; text-decoration: none")
    var poweredBy = Link(poweredByLabel(), poweredByUrl())
    poweredBy.setStyle(footer)

    // --- selectors: machine, example, language ---
    Ui.machineTitle = sectionTitle(Label(""))
    Ui.machines = Select(labMachineNames())
    Ui.machines.setSelected(labSelectedMachine())

    Ui.exampleTitle = sectionTitle(Label(""))
    Ui.examples = Select(labExampleNames())
    Ui.examples.setSelected(2)

    Ui.languageTitle = sectionTitle(Label(""))
    var languageNames: List<String> = listOf()
    for (var code in supportedLanguages()) { languageNames.add(languageLabel(code)) }
    Ui.languages = Select(languageNames)
    Ui.languages.setSelected(0)

    var selectors = Row(listOf(Ui.machineTitle, Ui.machines,
        Ui.exampleTitle, Ui.examples,
        Ui.languageTitle, Ui.languages))

    // --- source editor ---
    Ui.sourceTitle = sectionTitle(Label(""))
    Ui.editor = Textarea(labDefaultSource())
    Ui.editor.setRows(16)
    Ui.editor.setId("pubasm-source")

    // --- controls ---
    Ui.assembleButton = Button("", () -> onAssemble())
    Ui.resetButton = Button("", () -> onReset())
    Ui.stepButton = Button("", () -> onStep())
    Ui.runButton = Button("", () -> onRun())
    var controls = Row(listOf(Ui.assembleButton, Ui.resetButton,
        Ui.stepButton, Ui.runButton))

    Ui.message = Label("")
    Ui.message.fontSize = 12
    Ui.message.color = dataColor()

    // --- machine state ---
    Ui.machineSummary = Label("")
    Ui.machineSummary.color = dimColor()
    Ui.status = Label("")
    Ui.status.bold = true
    Ui.current = Label("")
    Ui.current.color = dataColor()
    Ui.sourceLine = Label("")
    Ui.sourceLine.color = dimColor()

    Ui.registersTitle = sectionTitle(Label(""))
    Ui.regA = Label("")
    Ui.regB = Label("")
    Ui.regC = Label("")
    Ui.regD = Label("")
    Ui.regX = Label("")
    Ui.regY = Label("")
    var registersPanel = View(panel)
    registersPanel.bind(Column(listOf(Ui.registersTitle,
        Ui.regA, Ui.regB, Ui.regC, Ui.regD, Ui.regX, Ui.regY)))

    Ui.flagsTitle = sectionTitle(Label(""))
    Ui.flags = Label("")
    Ui.flags.color = focusColor()
    var flagsPanel = View(panel)
    flagsPanel.bind(Column(listOf(Ui.flagsTitle, Ui.flags)))

    // --- output and diagnostics ---
    Ui.outputTitle = sectionTitle(Label(""))
    Ui.output = Label("")
    Ui.output.color = successColor()
    var outputPanel = View(panel)
    outputPanel.bind(Column(listOf(Ui.outputTitle, Ui.output)))

    Ui.diagnosticsTitle = sectionTitle(Label(""))
    Ui.diagnostics = Label("")
    Ui.diagnostics.color = errorColor()
    var diagnosticsPanel = View(panel)
    diagnosticsPanel.bind(Column(listOf(Ui.diagnosticsTitle, Ui.diagnostics)))

    // --- debugger: what the last instruction changed (phase 6) ---
    Ui.changesTitle = sectionTitle(Label(""))
    Ui.changes = Label("")
    Ui.changes.color = dataColor()
    var changesPanel = View(panel)
    changesPanel.bind(Column(listOf(Ui.changesTitle, Ui.changes)))

    // --- the educational layer: what the last instruction did (phase 7) ---
    Ui.explainTitle = sectionTitle(Label(""))
    Ui.explanation = Label("")
    Ui.explanation.color = focusColor()
    var explainPanel = View(panel)
    explainPanel.bind(Column(listOf(Ui.explainTitle, Ui.explanation)))

    // --- debugger: the memory dump (section 26) ---
    Ui.memoryTitle = sectionTitle(Label(""))
    Ui.viewTitle = sectionTitle(Label(""))
    Ui.memoryModes = Select(memoryModes())
    Ui.memoryModes.setSelected(0)
    Ui.memoryLegend = Label("")
    Ui.memoryLegend.fontSize = 11
    Ui.memoryLegend.color = dimColor()
    Ui.memoryDump = Label("")
    var memoryPanel = View(panel)
    memoryPanel.bind(Column(listOf(
        Row(listOf(Ui.memoryTitle, Ui.viewTitle, Ui.memoryModes)),
        Ui.memoryLegend, Ui.memoryDump)))

    // --- debugger: the stack (Advanced Mode, phase 8 stage A) ---
    Ui.stackTitle = sectionTitle(Label(""))
    Ui.stackPointer = Label("")
    Ui.stackPointer.color = dataColor()
    Ui.stackDump = Label("")
    Ui.stackNote = Label("")
    Ui.stackNote.fontSize = 11
    Ui.stackNote.color = dimColor()
    var stackPanel = View(panel)
    stackPanel.bind(Column(listOf(Ui.stackTitle, Ui.stackPointer, Ui.stackDump, Ui.stackNote)))

    // --- selector events ---
    Ui.machines.on("change", (e: Event) -> onMachineChange())
    Ui.examples.on("change", (e: Event) -> onExampleChange())
    Ui.languages.on("change", (e: Event) -> onLanguageChange())
    Ui.memoryModes.on("change", (e: Event) -> onMemoryModeChange())

    // --- phase 11 stage A: the 8051 laboratory ---
    // Its own self-contained section — no tab/visibility widget exists in
    // Kof's UI runtime (docs/architecture.md), so all three machines sit one
    // below another in this same window, rather than a dynamically
    // shown/hidden tab (docs/architecture-comparison.md).
    Ui.lab8051Title = Label("")
    Ui.lab8051Title.fontSize = 18
    Ui.lab8051Title.bold = true
    Ui.lab8051Title.color = focusColor()

    Ui.editor8051 = Textarea(lab8051DefaultSource())
    Ui.editor8051.setRows(10)
    Ui.editor8051.setId("i8051-source")

    Ui.assemble8051Button = Button("", () -> on8051Assemble())
    Ui.reset8051Button = Button("", () -> on8051Reset())
    Ui.step8051Button = Button("", () -> on8051Step())
    Ui.run8051Button = Button("", () -> on8051Run())
    var controls8051 = Row(listOf(Ui.assemble8051Button, Ui.reset8051Button,
        Ui.step8051Button, Ui.run8051Button))

    Ui.message8051 = Label("")
    Ui.message8051.fontSize = 12
    Ui.message8051.color = dataColor()
    Ui.status8051 = Label("")
    Ui.status8051.bold = true
    Ui.current8051 = Label("")
    Ui.current8051.color = dataColor()

    Ui.registers8051Title = sectionTitle(Label(""))
    Ui.registers8051 = Label("")
    var registers8051Panel = View(panel)
    registers8051Panel.bind(Column(listOf(Ui.registers8051Title, Ui.registers8051)))

    Ui.flags8051Title = sectionTitle(Label(""))
    Ui.flags8051 = Label("")
    Ui.flags8051.color = focusColor()
    var flags8051Panel = View(panel)
    flags8051Panel.bind(Column(listOf(Ui.flags8051Title, Ui.flags8051)))

    Ui.explain8051Title = sectionTitle(Label(""))
    Ui.explanation8051 = Label("")
    Ui.explanation8051.color = focusColor()
    var explain8051Panel = View(panel)
    explain8051Panel.bind(Column(listOf(Ui.explain8051Title, Ui.explanation8051)))

    Ui.output8051Title = sectionTitle(Label(""))
    Ui.output8051 = Label("")
    Ui.output8051.color = successColor()
    var output8051Panel = View(panel)
    output8051Panel.bind(Column(listOf(Ui.output8051Title, Ui.output8051)))

    Ui.diagnostics8051Title = sectionTitle(Label(""))
    Ui.diagnostics8051 = Label("")
    Ui.diagnostics8051.color = errorColor()
    var diagnostics8051Panel = View(panel)
    diagnostics8051Panel.bind(Column(listOf(Ui.diagnostics8051Title, Ui.diagnostics8051)))

    var lab8051Body = Column(listOf(Ui.lab8051Title,
        Ui.editor8051, controls8051, Ui.message8051,
        Ui.status8051, Ui.current8051,
        Row(listOf(registers8051Panel, flags8051Panel)),
        explain8051Panel, output8051Panel, diagnostics8051Panel))
    var lab8051Shell = View(root)
    lab8051Shell.bind(lab8051Body)

    // --- phase 11 stage A: the Cortex-M3 laboratory ---
    Ui.labM3Title = Label("")
    Ui.labM3Title.fontSize = 18
    Ui.labM3Title.bold = true
    Ui.labM3Title.color = focusColor()

    Ui.editorM3 = Textarea(labM3DefaultSource())
    Ui.editorM3.setRows(10)
    Ui.editorM3.setId("cm3-source")

    Ui.assembleM3Button = Button("", () -> onM3Assemble())
    Ui.resetM3Button = Button("", () -> onM3Reset())
    Ui.stepM3Button = Button("", () -> onM3Step())
    Ui.runM3Button = Button("", () -> onM3Run())
    var controlsM3 = Row(listOf(Ui.assembleM3Button, Ui.resetM3Button,
        Ui.stepM3Button, Ui.runM3Button))

    Ui.messageM3 = Label("")
    Ui.messageM3.fontSize = 12
    Ui.messageM3.color = dataColor()
    Ui.statusM3 = Label("")
    Ui.statusM3.bold = true
    Ui.currentM3 = Label("")
    Ui.currentM3.color = dataColor()

    Ui.registersM3Title = sectionTitle(Label(""))
    Ui.registersM3 = Label("")
    var registersM3Panel = View(panel)
    registersM3Panel.bind(Column(listOf(Ui.registersM3Title, Ui.registersM3)))

    Ui.flagsM3Title = sectionTitle(Label(""))
    Ui.flagsM3 = Label("")
    Ui.flagsM3.color = focusColor()
    var flagsM3Panel = View(panel)
    flagsM3Panel.bind(Column(listOf(Ui.flagsM3Title, Ui.flagsM3)))

    Ui.explainM3Title = sectionTitle(Label(""))
    Ui.explanationM3 = Label("")
    Ui.explanationM3.color = focusColor()
    var explainM3Panel = View(panel)
    explainM3Panel.bind(Column(listOf(Ui.explainM3Title, Ui.explanationM3)))

    Ui.outputM3Title = sectionTitle(Label(""))
    Ui.outputM3 = Label("")
    Ui.outputM3.color = successColor()
    var outputM3Panel = View(panel)
    outputM3Panel.bind(Column(listOf(Ui.outputM3Title, Ui.outputM3)))

    Ui.diagnosticsM3Title = sectionTitle(Label(""))
    Ui.diagnosticsM3 = Label("")
    Ui.diagnosticsM3.color = errorColor()
    var diagnosticsM3Panel = View(panel)
    diagnosticsM3Panel.bind(Column(listOf(Ui.diagnosticsM3Title, Ui.diagnosticsM3)))

    var labM3Body = Column(listOf(Ui.labM3Title,
        Ui.editorM3, controlsM3, Ui.messageM3,
        Ui.statusM3, Ui.currentM3,
        Row(listOf(registersM3Panel, flagsM3Panel)),
        explainM3Panel, outputM3Panel, diagnosticsM3Panel))
    var labM3Shell = View(root)
    labM3Shell.bind(labM3Body)

    // --- phase 11 stage B: the comparison view ---
    Ui.compareTitle = Label("")
    Ui.compareTitle.fontSize = 18
    Ui.compareTitle.bold = true
    Ui.compareTitle.color = focusColor()

    Ui.compareSetLabel = sectionTitle(Label(""))
    var compareSetNames: List<String> = listOf()
    var compareIndex = 0
    while (compareIndex < compareSetCount()) {
        compareSetNames.add(compareSetTitle(compareIndex, "en"))
        compareIndex = compareIndex + 1
    }
    Ui.compareSets = Select(compareSetNames)
    Ui.compareSets.setSelected(0)
    Ui.compareSets.on("change", (e: Event) -> onCompareSetChange())

    Ui.compareDescription = Label("")
    Ui.compareDescription.fontSize = 12
    Ui.compareDescription.color = dimColor()

    Ui.compareAssembleButton = Button("", () -> onCompareAssemble())
    Ui.compareStepButton = Button("", () -> onCompareStep())
    var compareControls = Row(listOf(Ui.compareAssembleButton, Ui.compareStepButton))

    Ui.compareMessage = Label("")
    Ui.compareMessage.fontSize = 12
    Ui.compareMessage.color = dataColor()

    Ui.comparePubvmLabel = sectionTitle(Label(""))
    Ui.comparePubvmStatus = Label("")
    Ui.comparePubvmOutput = Label("")
    Ui.comparePubvmOutput.color = successColor()
    Ui.comparePubvmExplain = Label("")
    Ui.comparePubvmExplain.color = focusColor()
    var comparePubvmPanel = View(panel)
    comparePubvmPanel.bind(Column(listOf(Ui.comparePubvmLabel,
        Ui.comparePubvmStatus, Ui.comparePubvmOutput, Ui.comparePubvmExplain)))

    Ui.compare8051Label = sectionTitle(Label(""))
    Ui.compare8051Status = Label("")
    Ui.compare8051Output = Label("")
    Ui.compare8051Output.color = successColor()
    Ui.compare8051Explain = Label("")
    Ui.compare8051Explain.color = focusColor()
    var compare8051Panel = View(panel)
    compare8051Panel.bind(Column(listOf(Ui.compare8051Label,
        Ui.compare8051Status, Ui.compare8051Output, Ui.compare8051Explain)))

    Ui.compareM3Label = sectionTitle(Label(""))
    Ui.compareM3Status = Label("")
    Ui.compareM3Output = Label("")
    Ui.compareM3Output.color = successColor()
    Ui.compareM3Explain = Label("")
    Ui.compareM3Explain.color = focusColor()
    var compareM3Panel = View(panel)
    compareM3Panel.bind(Column(listOf(Ui.compareM3Label,
        Ui.compareM3Status, Ui.compareM3Output, Ui.compareM3Explain)))

    var compareBody = Column(listOf(Ui.compareTitle,
        Row(listOf(Ui.compareSetLabel, Ui.compareSets)),
        Ui.compareDescription, compareControls, Ui.compareMessage,
        Row(listOf(comparePubvmPanel, compare8051Panel, compareM3Panel))))
    var compareShell = View(root)
    compareShell.bind(compareBody)

    // --- compose ---
    var body = Column(listOf(header, Hr(), selectors, Hr(),
        Ui.sourceTitle, Ui.editor, controls, Ui.message, Hr(),
        Ui.machineSummary, Ui.status, Ui.current, Ui.sourceLine, Hr(),
        Row(listOf(registersPanel, flagsPanel)),
        explainPanel, changesPanel, memoryPanel, stackPanel,
        outputPanel, diagnosticsPanel,
        Hr(), lab8051Shell, Hr(), labM3Shell,
        Hr(), compareShell,
        Hr(), poweredBy))
    var shell = View(root)
    shell.bind(body)
    Ui.window.bind(shell)

    labSelectMachine(0)
    relabel()
    refresh()
    relabel8051()
    refresh8051()
    relabelM3()
    relabelCompare()
    refreshCompare()
    refreshM3()
    Ui.window.show()
}
