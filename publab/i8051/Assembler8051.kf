package publab.i8051

// The 8051 assembler. Two passes, same shape as PubVM's:
//   pass 1  resolve each line against the opcode table, compute its length
//           and address; then build the symbol table from the labels
//   pass 2  encode the bytes, resolving label references
//
// The image is only meaningful when `ok` is true.

record SourceMapEntry8051(Int address, Int line, Int instructionIndex)

record Symbol8051(String name, Int address)

record AssemblyResult8051(Bool ok, List<Int> image, Int byteCount,
                          List<Diagnostic8051> diagnostics, List<SourceMapEntry8051> sourceMap,
                          List<Symbol8051> symbols)

record Placed8051(Int index, Int address, Int opcode, Int form, Int length)

List<Int> newImage8051() {
    var l: List<Int> = listOf()
    return l
}

List<Placed8051> emptyPlaced8051() {
    var l: List<publab.i8051.Placed8051> = listOf()
    return l
}

List<Symbol8051> emptySymbols8051() {
    var l: List<publab.i8051.Symbol8051> = listOf()
    return l
}

List<SourceMapEntry8051> emptySourceMap8051() {
    var l: List<publab.i8051.SourceMapEntry8051> = listOf()
    return l
}

AssemblyResult8051 failedAssembly8051(List<Diagnostic8051> diagnostics) {
    return AssemblyResult8051(false, newImage8051(), 0, diagnostics, emptySourceMap8051(), emptySymbols8051())
}

Bool allFormsShareOperandCount8051(List<Int> forms, Int count) {
    for (var f in forms) {
        if (formOperandCount8051(f) != count) { return false }
    }
    return forms.size > 0
}

Bool immediateFits8051(Long value) {
    return value >= (0 as Long) && value <= wordMaxUnsigned8051()
}

Long wordMaxUnsigned8051() {
    return 255 as Long
}

Bool directFits8051(Long value) {
    return value >= (0 as Long) && value < (internalDataSize8051() as Long)
}

record SymbolLookup8051(Bool found, Int address)

SymbolLookup8051 findSymbol8051(List<Symbol8051> symbols, String name) {
    for (var s in symbols) {
        if (s.name() == name) { return SymbolLookup8051(true, s.address()) }
    }
    return SymbolLookup8051(false, 0)
}

Int firstDefinitionLine8051(List<LabelDef8051> labels, String name) {
    for (var label in labels) {
        if (label.name() == name) { return label.line() }
    }
    return 0
}

Bool mistypedRegister8051(ParsedInstruction8051 instruction, List<Int> acceptedForms) {
    if (acceptedForms.contains(formAddr8051())) { return false }
    for (var operand in instruction.operands()) {
        if (operand.kind() == "label") { return true }
    }
    return false
}

Int resolveAddressOperand8051(Operand8051 operand, List<Symbol8051> symbols,
                              List<Diagnostic8051> diagnostics) {
    var address = 0
    var resolved = true
    if (operand.kind() == "direct") {
        address = (operand.value() as Int)
    } else {
        val found = findSymbol8051(symbols, operand.label())
        if (found.found()) {
            address = found.address()
        } else {
            diagnostics.add(errorAt8051("I51007", operand.line(), operand.column(),
                args1_8051(operand.label())))
            resolved = false
        }
    }
    if (resolved) {
        if (address < 0 || address >= codeMemorySize8051()) {
            diagnostics.add(errorAt8051("I51009", operand.line(), operand.column(),
                args1_8051("" + address)))
            resolved = false
        }
    }
    if (!resolved) { address = 0 }
    return address
}

AssemblyResult8051 assembleSource8051(String source) {
    val lexed = lexSource8051(source)
    var diagnostics = emptyDiagnostics8051()
    for (var d in lexed.diagnostics()) { diagnostics.add(d) }
    val parsed = parseTokens8051(lexed.tokens())
    for (var d in parsed.diagnostics()) { diagnostics.add(d) }
    if (hasErrors8051(diagnostics)) { return failedAssembly8051(diagnostics) }

    val instructions = parsed.instructions()

    var placed = emptyPlaced8051()
    var address = 0
    var index = 0
    for (var instruction in instructions) {
        val mnemonic = instruction.mnemonic()
        val accepted = formsForMnemonic8051(mnemonic)
        if (!mnemonicExists8051(mnemonic)) {
            diagnostics.add(errorAt8051("I51001", instruction.line(), instruction.column(),
                args1_8051(mnemonic)))
        } else if (mistypedRegister8051(instruction, accepted)) {
            for (var operand in instruction.operands()) {
                if (operand.kind() == "label") {
                    diagnostics.add(errorAt8051("I51004", operand.line(), operand.column(),
                        args1_8051(operand.label())))
                }
            }
        } else {
            val guess = formFromOperands8051(instruction.operands())
            var resolvedOk = false
            if (guess.ok()) {
                val look = lookupInstruction8051(mnemonic, guess.form())
                if (look.found()) {
                    val accOk = !mnemonicRequiresAccumulator(mnemonic)
                        || instruction.operands().get(0).reg() == regA()
                    if (!accOk) {
                        diagnostics.add(errorAt8051("I51014", instruction.line(), instruction.column(),
                            args1_8051(mnemonic.toUpperCase())))
                    } else {
                        resolvedOk = true
                        placed.add(Placed8051(index, address, look.opcode(), look.form(),
                            instructionLength8051(look.form())))
                    }
                }
            }
            if (!resolvedOk) {
                val given = instruction.operands().size
                if (allFormsShareOperandCount8051(accepted, formOperandCount8051(accepted.get(0)))
                        && formOperandCount8051(accepted.get(0)) != given) {
                    diagnostics.add(errorAt8051("I51003", instruction.line(), instruction.column(),
                        args3_8051(mnemonic.toUpperCase(), "" + formOperandCount8051(accepted.get(0)),
                            "" + given)))
                } else {
                    diagnostics.add(errorAt8051("I51002", instruction.line(), instruction.column(),
                        args2_8051(mnemonic.toUpperCase(), acceptedFormsText8051(accepted))))
                }
            }
        }
        if (placed.size > 0) {
            val last = placed.get(placed.size - 1)
            if (last.index() == index) { address = address + last.length() }
        }
        index = index + 1
    }
    if (hasErrors8051(diagnostics)) { return failedAssembly8051(diagnostics) }

    if (address > codeMemorySize8051()) {
        diagnostics.add(errorAt8051("I51013", 1, 0,
            args2_8051("" + address, "" + codeMemorySize8051())))
        return failedAssembly8051(diagnostics)
    }

    var symbols = emptySymbols8051()
    for (var label in parsed.labels()) {
        val existing = findSymbol8051(symbols, label.name())
        if (existing.found()) {
            diagnostics.add(errorAt8051("I51008", label.line(), label.column(),
                args2_8051(label.name(), "" + firstDefinitionLine8051(parsed.labels(), label.name()))))
        } else {
            var target = address
            if (label.instructionIndex() < placed.size) {
                target = placed.get(label.instructionIndex()).address()
            }
            symbols.add(Symbol8051(label.name(), target))
        }
    }
    if (hasErrors8051(diagnostics)) { return failedAssembly8051(diagnostics) }

    var image = newImage8051()
    var sourceMap = emptySourceMap8051()
    var i = 0
    while (i < placed.size) {
        val spot = placed.get(i)
        val instruction = instructions.get(spot.index())
        val operands = instruction.operands()
        sourceMap.add(SourceMapEntry8051(spot.address(), instruction.line(), spot.index()))
        image.add(spot.opcode())
        val form = spot.form()
        if (form == formReg8051()) {
            image.add(operands.get(0).reg())
        } else if (form == formRegImm8051()) {
            image.add(operands.get(0).reg())
            val immediate = operands.get(1)
            if (!immediateFits8051(immediate.value())) {
                diagnostics.add(errorAt8051("I51005", immediate.line(), immediate.column(),
                    args1_8051("" + immediate.value())))
            }
            image.add((immediate.value() as Int) & 255)
        } else if (form == formRegReg8051()) {
            image.add(operands.get(0).reg())
            image.add(operands.get(1).reg())
        } else if (form == formRegDirect8051()) {
            image.add(operands.get(0).reg())
            val direct = operands.get(1)
            if (!directFits8051(direct.value())) {
                diagnostics.add(errorAt8051("I51006", direct.line(), direct.column(),
                    args1_8051("" + direct.value())))
            }
            image.add((direct.value() as Int) & 127)
        } else if (form == formDirectReg8051()) {
            val direct = operands.get(0)
            if (!directFits8051(direct.value())) {
                diagnostics.add(errorAt8051("I51006", direct.line(), direct.column(),
                    args1_8051("" + direct.value())))
            }
            image.add((direct.value() as Int) & 127)
            image.add(operands.get(1).reg())
        } else if (form == formAddr8051()) {
            val target = resolveAddressOperand8051(operands.get(0), symbols, diagnostics)
            image.add(target & 255)
            image.add((((target as Long) >>> 8) as Int) & 255)
        }
        i = i + 1
    }
    if (hasErrors8051(diagnostics)) { return failedAssembly8051(diagnostics) }
    return AssemblyResult8051(true, image, image.size, diagnostics, sourceMap, symbols)
}

// A language-neutral list of accepted forms, already expanded to English —
// unlike PubASM's "form:" trick, kept simple since this catalogue is small.
String acceptedFormsText8051(List<Int> forms) {
    var out = ""
    for (var f in forms) {
        if (out.length > 0) { out = out + " / " }
        out = out + formDescription8051(f)
    }
    return out
}
