package publab.i8051

// The 8051 assembler's lexer. One instruction per line. A comment starts
// with ';'. Token kinds: ident, number, comma, colon, hash, eol, eof.
//
// `hash` is the one token PubASM's lexer does not need: real 8051 syntax
// marks an immediate with '#' (`MOV A, #5`), where PubASM marks a memory
// operand with brackets instead. That is the one real syntactic difference
// this lexer exists for — everything else here is otherwise the same shape
// as publab.assembler.Lexer, deliberately not shared, since the 8051
// module owns its own tools end to end (see docs/8051.md).

record Token8051(String kind, String text, Long value, Int line, Int column)

record LexResult8051(List<Token8051> tokens, List<Diagnostic8051> diagnostics)

List<Token8051> emptyTokens8051() {
    var l: List<publab.i8051.Token8051> = listOf()
    return l
}

Bool isDigitChar8051(Char c) {
    return c >= '0' && c <= '9'
}

Bool isLetterChar8051(Char c) {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'
}

Bool isIdentChar8051(Char c) {
    return isLetterChar8051(c) || isDigitChar8051(c)
}

Bool isHexDigitChar8051(Char c) {
    return isDigitChar8051(c) || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F')
}

Int hexDigitValue8051(Char c) {
    if (isDigitChar8051(c)) {
        return (c as Int) - ('0' as Int)
    } else if (c >= 'a' && c <= 'f') {
        return 10 + (c as Int) - ('a' as Int)
    } else {
        return 10 + (c as Int) - ('A' as Int)
    }
}

Long literalCeiling8051() {
    return 999999999999 as Long
}

record NumberScan8051(Bool ok, Long value, String text, Int next)

NumberScan8051 scanNumber8051(String source, Int start) {
    val n = source.length
    var i = start
    var negative = false
    if (source.charAt(i) == '-') {
        negative = true
        i = i + 1
    }
    var base = 10
    if (i + 1 < n && source.charAt(i) == '0') {
        val marker = source.charAt(i + 1)
        if (marker == 'x' || marker == 'X') {
            base = 16
            i = i + 2
        } else if (marker == 'b' || marker == 'B') {
            base = 2
            i = i + 2
        }
    }
    var digits = 0
    var malformed = false
    var value: Long = 0 as Long
    var scanning = true
    while (scanning && i < n) {
        val c = source.charAt(i)
        if (!isIdentChar8051(c)) {
            scanning = false
        } else {
            var digitValue = -1
            if (base == 16 && isHexDigitChar8051(c)) {
                digitValue = hexDigitValue8051(c)
            } else if (base == 10 && isDigitChar8051(c)) {
                digitValue = hexDigitValue8051(c)
            } else if (base == 2 && (c == '0' || c == '1')) {
                digitValue = hexDigitValue8051(c)
            }
            if (digitValue < 0) {
                malformed = true
            } else {
                value = value * (base as Long) + (digitValue as Long)
                if (value > literalCeiling8051()) { malformed = true }
            }
            digits = digits + 1
            i = i + 1
        }
    }
    val text = source.substring(start, i)
    if (digits == 0 || malformed) {
        return NumberScan8051(false, 0 as Long, text, i)
    }
    if (negative) {
        return NumberScan8051(true, (0 as Long) - value, text, i)
    }
    return NumberScan8051(true, value, text, i)
}

Int skipToLineEnd8051(String source, Int from) {
    val n = source.length
    var i = from
    while (i < n && source.charAt(i) != '\n') { i = i + 1 }
    return i
}

Bool startsNumber8051(String source, Int i) {
    val n = source.length
    val c = source.charAt(i)
    if (isDigitChar8051(c)) { return true }
    return c == '-' && i + 1 < n && isDigitChar8051(source.charAt(i + 1))
}

LexResult8051 lexSource8051(String source) {
    var tokens = emptyTokens8051()
    var diagnostics = emptyDiagnostics8051()
    val n = source.length
    var i = 0
    var line = 1
    var lineStart = 0
    while (i < n) {
        val c = source.charAt(i)
        val column = i - lineStart + 1
        if (c == '\n') {
            tokens.add(Token8051("eol", "", 0 as Long, line, column))
            i = i + 1
            line = line + 1
            lineStart = i
        } else if (c == ' ' || c == '\t' || c == '\r') {
            i = i + 1
        } else if (c == ';') {
            i = skipToLineEnd8051(source, i)
        } else if (c == ',') {
            tokens.add(Token8051("comma", ",", 0 as Long, line, column))
            i = i + 1
        } else if (c == ':') {
            tokens.add(Token8051("colon", ":", 0 as Long, line, column))
            i = i + 1
        } else if (c == '#') {
            tokens.add(Token8051("hash", "#", 0 as Long, line, column))
            i = i + 1
        } else if (startsNumber8051(source, i)) {
            val scan = scanNumber8051(source, i)
            if (scan.ok()) {
                tokens.add(Token8051("number", scan.text(), scan.value(), line, column))
            } else {
                diagnostics.add(errorAt8051("I51011", line, column, args1_8051(scan.text())))
            }
            i = scan.next()
        } else if (isLetterChar8051(c)) {
            var j = i
            while (j < n && isIdentChar8051(source.charAt(j))) { j = j + 1 }
            tokens.add(Token8051("ident", source.substring(i, j), 0 as Long, line, column))
            i = j
        } else {
            diagnostics.add(errorAt8051("I51010", line, column, args1_8051("" + c)))
            i = i + 1
        }
    }
    tokens.add(Token8051("eof", "", 0 as Long, line, n - lineStart + 1))
    return LexResult8051(tokens, diagnostics)
}
