package publab.cm3

import publab.machine

// The Cortex-M3 assembler. Two passes, same shape as PubVM's and the
// 8051's. PUSH/POP's register-list form is the one real variable-length
// encoding this project has — its length depends on how many registers
// were written between the braces, so pass 1 cannot use a fixed
// instructionLengthM3(form) for it the way every other form can.

record SourceMapEntryM3(Int address, Int line, Int instructionIndex)

record SymbolM3(String name, Int address)

record AssemblyResultM3(Bool ok, List<Int> image, Int byteCount,
                        List<DiagnosticM3> diagnostics, List<SourceMapEntryM3> sourceMap,
                        List<SymbolM3> symbols)

record PlacedM3(Int index, Int address, Int opcode, Int form, Int length, List<Int> regs)

List<Int> newImageM3() {
    var l: List<Int> = listOf()
    return l
}

List<PlacedM3> emptyPlacedM3() {
    var l: List<publab.cm3.PlacedM3> = listOf()
    return l
}

List<SymbolM3> emptySymbolsM3() {
    var l: List<publab.cm3.SymbolM3> = listOf()
    return l
}

List<SourceMapEntryM3> emptySourceMapM3() {
    var l: List<publab.cm3.SourceMapEntryM3> = listOf()
    return l
}

AssemblyResultM3 failedAssemblyM3(List<DiagnosticM3> diagnostics) {
    return AssemblyResultM3(false, newImageM3(), 0, diagnostics, emptySourceMapM3(), emptySymbolsM3())
}

Bool allFormsShareOperandCountM3(List<Int> forms, Int count) {
    for (var f in forms) {
        if (formOperandCountM3(f) != count) { return false }
    }
    return forms.size > 0
}

Bool immediateFitsM3(Long value) {
    return value >= (0 as Long) && value <= wordMaxUnsigned(widthM3())
}

Bool offsetFitsM3(Long value) {
    return value >= (0 as Long) && value < (memorySizeM3() as Long)
}

record SymbolLookupM3(Bool found, Int address)

SymbolLookupM3 findSymbolM3(List<SymbolM3> symbols, String name) {
    for (var s in symbols) {
        if (s.name() == name) { return SymbolLookupM3(true, s.address()) }
    }
    return SymbolLookupM3(false, 0)
}

Int firstDefinitionLineM3(List<LabelDefM3> labels, String name) {
    for (var label in labels) {
        if (label.name() == name) { return label.line() }
    }
    return 0
}

Bool mistypedRegisterM3(ParsedInstructionM3 instruction, List<Int> acceptedForms) {
    if (acceptedForms.contains(formAddrM3())) { return false }
    for (var operand in instruction.operands()) {
        if (operand.kind() == "label") { return true }
    }
    return false
}

// Any operand this instruction uses outside R0-R12 (SP/LR) fails the
// low-register restriction (docs/cortex-m3.md).
Bool usesOnlyLowRegisters(ParsedInstructionM3 instruction) {
    for (var operand in instruction.operands()) {
        if (operand.kind() == "reg" && !isLowRegister(operand.reg())) { return false }
    }
    return true
}

Int resolveAddressOperandM3(OperandM3 operand, List<SymbolM3> symbols,
                           List<DiagnosticM3> diagnostics) {
    var address = 0
    var resolved = true
    val found = findSymbolM3(symbols, operand.label())
    if (found.found()) {
        address = found.address()
    } else {
        diagnostics.add(errorAtM3("M3007", operand.line(), operand.column(),
            args1M3(operand.label())))
        resolved = false
    }
    if (resolved) {
        if (address < 0 || address >= memorySizeM3()) {
            diagnostics.add(errorAtM3("M3009", operand.line(), operand.column(),
                args1M3("" + address)))
            resolved = false
        }
    }
    if (!resolved) { address = 0 }
    return address
}

void appendWordBytesM3(List<Int> image, Long value, Int bytes) {
    var i = 0
    while (i < bytes) {
        image.add((((value >>> (i * 8)) & (255 as Long)) as Int))
        i = i + 1
    }
}

AssemblyResultM3 assembleSourceM3(String source) {
    val lexed = lexSourceM3(source)
    var diagnostics = emptyDiagnosticsM3()
    for (var d in lexed.diagnostics()) { diagnostics.add(d) }
    val parsed = parseTokensM3(lexed.tokens())
    for (var d in parsed.diagnostics()) { diagnostics.add(d) }
    if (hasErrorsM3(diagnostics)) { return failedAssemblyM3(diagnostics) }

    val instructions = parsed.instructions()

    var placed = emptyPlacedM3()
    var address = 0
    var index = 0
    for (var instruction in instructions) {
        val mnemonic = instruction.mnemonic()
        val accepted = formsForMnemonicM3(mnemonic)
        if (!mnemonicExistsM3(mnemonic)) {
            diagnostics.add(errorAtM3("M3001", instruction.line(), instruction.column(),
                args1M3(mnemonic)))
        } else if (mistypedRegisterM3(instruction, accepted)) {
            for (var operand in instruction.operands()) {
                if (operand.kind() == "label") {
                    diagnostics.add(errorAtM3("M3004", operand.line(), operand.column(),
                        args1M3(operand.label())))
                }
            }
        } else {
            val guess = formFromOperandsM3(instruction.operands())
            var resolvedOk = false
            if (guess.ok()) {
                val look = lookupInstructionM3(mnemonic, guess.form())
                if (look.found()) {
                    val lowOk = !mnemonicRequiresLowRegisters(mnemonic) || usesOnlyLowRegisters(instruction)
                    val lrOk = !mnemonicRequiresLR(mnemonic)
                        || (instruction.operands().get(0).reg() == regLR())
                    if (!lowOk) {
                        diagnostics.add(errorAtM3("M3014", instruction.line(), instruction.column(),
                            args1M3(mnemonic.toUpperCase())))
                    } else if (!lrOk) {
                        diagnostics.add(errorAtM3("M3016", instruction.line(), instruction.column(),
                            noArgsM3()))
                    } else {
                        resolvedOk = true
                        var length = instructionLengthM3(look.form())
                        var regs: List<Int> = listOf()
                        if (look.form() == formRegListM3()) {
                            regs = instruction.operands().get(0).regs()
                            length = regListLengthM3(regs.size)
                        }
                        placed.add(PlacedM3(index, address, look.opcode(), look.form(), length, regs))
                    }
                }
            }
            if (!resolvedOk) {
                val given = instruction.operands().size
                if (allFormsShareOperandCountM3(accepted, formOperandCountM3(accepted.get(0)))
                        && formOperandCountM3(accepted.get(0)) != given) {
                    diagnostics.add(errorAtM3("M3003", instruction.line(), instruction.column(),
                        args3M3(mnemonic.toUpperCase(), "" + formOperandCountM3(accepted.get(0)),
                            "" + given)))
                } else {
                    diagnostics.add(errorAtM3("M3002", instruction.line(), instruction.column(),
                        args2M3(mnemonic.toUpperCase(), acceptedFormsTextM3(accepted))))
                }
            }
        }
        if (placed.size > 0) {
            val last = placed.get(placed.size - 1)
            if (last.index() == index) { address = address + last.length() }
        }
        index = index + 1
    }
    if (hasErrorsM3(diagnostics)) { return failedAssemblyM3(diagnostics) }

    if (address > memorySizeM3()) {
        diagnostics.add(errorAtM3("M3013", 1, 0,
            args2M3("" + address, "" + memorySizeM3())))
        return failedAssemblyM3(diagnostics)
    }

    var symbols = emptySymbolsM3()
    for (var label in parsed.labels()) {
        val existing = findSymbolM3(symbols, label.name())
        if (existing.found()) {
            diagnostics.add(errorAtM3("M3008", label.line(), label.column(),
                args2M3(label.name(), "" + firstDefinitionLineM3(parsed.labels(), label.name()))))
        } else {
            var target = address
            if (label.instructionIndex() < placed.size) {
                target = placed.get(label.instructionIndex()).address()
            }
            symbols.add(SymbolM3(label.name(), target))
        }
    }
    if (hasErrorsM3(diagnostics)) { return failedAssemblyM3(diagnostics) }

    var image = newImageM3()
    var sourceMap = emptySourceMapM3()
    var i = 0
    while (i < placed.size) {
        val spot = placed.get(i)
        val instruction = instructions.get(spot.index())
        val operands = instruction.operands()
        sourceMap.add(SourceMapEntryM3(spot.address(), instruction.line(), spot.index()))
        image.add(spot.opcode())
        val form = spot.form()
        if (form == formRegM3()) {
            image.add(operands.get(0).reg())
        } else if (form == formRegImmM3()) {
            image.add(operands.get(0).reg())
            val immediate = operands.get(1)
            if (!immediateFitsM3(immediate.value())) {
                diagnostics.add(errorAtM3("M3005", immediate.line(), immediate.column(),
                    args1M3("" + immediate.value())))
            }
            appendWordBytesM3(image, immediate.value(), immediateBytesM3())
        } else if (form == formRegRegM3()) {
            image.add(operands.get(0).reg())
            image.add(operands.get(1).reg())
        } else if (form == formRegMemM3()) {
            image.add(operands.get(0).reg())
            val mem = operands.get(1)
            image.add(mem.reg())
            if (!offsetFitsM3(mem.value())) {
                diagnostics.add(errorAtM3("M3006", mem.line(), mem.column(), args1M3("" + mem.value())))
            }
            appendWordBytesM3(image, mem.value(), offsetBytesM3())
        } else if (form == formRegRegRegM3()) {
            image.add(operands.get(0).reg())
            image.add(operands.get(1).reg())
            image.add(operands.get(2).reg())
        } else if (form == formRegRegImmM3()) {
            image.add(operands.get(0).reg())
            image.add(operands.get(1).reg())
            val immediate = operands.get(2)
            if (!immediateFitsM3(immediate.value())) {
                diagnostics.add(errorAtM3("M3005", immediate.line(), immediate.column(),
                    args1M3("" + immediate.value())))
            }
            appendWordBytesM3(image, immediate.value(), immediateBytesM3())
        } else if (form == formAddrM3()) {
            val target = resolveAddressOperandM3(operands.get(0), symbols, diagnostics)
            appendWordBytesM3(image, target as Long, addressBytesM3())
        } else if (form == formRegListM3()) {
            image.add(spot.regs().size)
            for (var r in spot.regs()) { image.add(r) }
        }
        i = i + 1
    }
    if (hasErrorsM3(diagnostics)) { return failedAssemblyM3(diagnostics) }
    return AssemblyResultM3(true, image, image.size, diagnostics, sourceMap, symbols)
}

String acceptedFormsTextM3(List<Int> forms) {
    var out = ""
    for (var f in forms) {
        if (out.length > 0) { out = out + " / " }
        out = out + formDescriptionM3(f)
    }
    return out
}
