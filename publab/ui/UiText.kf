package publab.ui

// Every translatable string of the interface, in one place — the same rule the
// assembler's Messages.kf follows (section 40). No widget anywhere carries a
// literal sentence; it asks for one by name and language.

Bool isPt(String language) {
    return language == "pt" || language == "pt_BR" || language == "pt-BR"
}

List<String> supportedLanguages() {
    return listOf("en", "pt")
}

String languageLabel(String language) {
    if (isPt(language)) { return "Português" }
    return "English"
}

// --- panel titles ---

String sourceTitle(String language) {
    if (isPt(language)) { return "FONTE" }
    return "SOURCE"
}

String registersTitle(String language) {
    if (isPt(language)) { return "REGISTRADORES" }
    return "REGISTERS"
}

String flagsTitle(String language) {
    if (isPt(language)) { return "FLAGS" }
    return "FLAGS"
}

String outputTitle(String language) {
    if (isPt(language)) { return "SAÍDA" }
    return "OUTPUT"
}

String diagnosticsTitle(String language) {
    if (isPt(language)) { return "DIAGNÓSTICOS" }
    return "DIAGNOSTICS"
}

String machineTitle(String language) {
    if (isPt(language)) { return "MÁQUINA" }
    return "MACHINE"
}

String exampleTitle(String language) {
    if (isPt(language)) { return "EXEMPLO" }
    return "EXAMPLE"
}

String languageTitle(String language) {
    if (isPt(language)) { return "IDIOMA" }
    return "LANGUAGE"
}

// --- controls ---

String assembleButton(String language) {
    if (isPt(language)) { return "Montar" }
    return "Assemble"
}

String resetButton(String language) {
    if (isPt(language)) { return "Reiniciar" }
    return "Reset"
}

String stepButton(String language) {
    if (isPt(language)) { return "Passo" }
    return "Step"
}

String runButton(String language) {
    if (isPt(language)) { return "Executar" }
    return "Run"
}

// --- state words ---

String statusWord(String canonical, String language) {
    if (!isPt(language)) { return canonical }
    if (canonical == "READY") { return "PRONTA" }
    if (canonical == "RUNNING") { return "EXECUTANDO" }
    if (canonical == "PAUSED") { return "PAUSADA" }
    if (canonical == "HALTED") { return "PARADA" }
    return "ERRO"
}

String currentWord(String language) {
    if (isPt(language)) { return "ATUAL" }
    return "CURRENT"
}

String cyclesWord(String language) {
    if (isPt(language)) { return "ciclos" }
    return "cycles"
}

String wordSizeWord(String language) {
    if (isPt(language)) { return "bits de palavra" }
    return "bit word"
}

String memoryWord(String language) {
    if (isPt(language)) { return "de memória" }
    return "of memory"
}

// --- messages ---

String assembledMessage(Int bytes, String language) {
    if (isPt(language)) { return "montado: " + bytes + " bytes carregados na memória" }
    return "assembled: " + bytes + " bytes loaded into memory"
}

String notAssembledMessage(String language) {
    if (isPt(language)) { return "nada montado ainda — escreva PubASM e clique em Montar" }
    return "nothing assembled yet — write PubASM and press Assemble"
}

String didNotFinishMessage(Int cycles, String language) {
    if (isPt(language)) {
        return "não terminou: " + cycles + " ciclos executados e o orçamento acabou."
            + " O programa pode estar em laço infinito. Clique em Executar para continuar."
    }
    return "did not finish: " + cycles + " cycles ran and the budget ended."
        + " The program may be looping forever. Press Run to continue."
}

String haltedMessage(Int cycles, String language) {
    if (isPt(language)) { return "parada após " + cycles + " ciclos" }
    return "halted after " + cycles + " cycles"
}

String errorMessage(String fault, String language) {
    if (isPt(language)) { return "falha de execução: " + fault }
    return "execution fault: " + fault
}

String assemblyFailedMessage(String language) {
    if (isPt(language)) { return "não montou — nada foi carregado na máquina" }
    return "did not assemble — nothing was loaded into the machine"
}

String noOutputMessage(String language) {
    if (isPt(language)) { return "(sem saída — use PRINT)" }
    return "(no output — use PRINT)"
}

String emptyDiagnosticsMessage(String language) {
    if (isPt(language)) { return "(sem diagnósticos)" }
    return "(no diagnostics)"
}

String pausedAtMessage(Int cycles, String language) {
    if (isPt(language)) { return "pausada — " + cycles + " ciclos, pronta para o próximo passo" }
    return "paused — " + cycles + " cycles, ready for the next step"
}

// --- debugger (phase 6) ---

String memoryTitle(String language) {
    if (isPt(language)) { return "MEMÓRIA" }
    return "MEMORY"
}

String changesTitle(String language) {
    if (isPt(language)) { return "MUDANÇAS DA ÚLTIMA INSTRUÇÃO" }
    return "WHAT THE LAST INSTRUCTION CHANGED"
}

String viewTitle(String language) {
    if (isPt(language)) { return "VISÃO" }
    return "VIEW"
}

// --- educational layer (phase 7) ---

String explainTitle(String language) {
    if (isPt(language)) { return "EXPLICAÇÃO" }
    return "EXPLANATION"
}

String noExplainYet(String language) {
    if (isPt(language)) {
        return "Monte um programa e clique em Passo para ver a explicação da instrução."
    }
    return "Assemble a program and press Step to see the instruction explained."
}

// Phase 8 (Advanced Mode) is complete: stages A and B gave the stack SP, FP,
// PUSH, POP, CALL, RET, ENTER and LEAVE; stage C's shifts, rotates and extra
// conditional jumps do not touch this panel (they never touch the stack).
String stackNote(String language) {
    if (isPt(language)) {
        return "PUSH, POP, CALL, RET, ENTER e LEAVE movem esta pilha."
    }
    return "PUSH, POP, CALL, RET, ENTER and LEAVE move this stack."
}

String stackTitle(String language) {
    if (isPt(language)) { return "PILHA" }
    return "STACK"
}

// --- phase 11 stage A: the 8051 and Cortex-M3 tabs ---

String lab8051Title(String language) {
    if (isPt(language)) { return "LABORATÓRIO 8051" }
    return "8051 LABORATORY"
}

String labM3Title(String language) {
    if (isPt(language)) { return "LABORATÓRIO CORTEX-M3" }
    return "CORTEX-M3 LABORATORY"
}

// Kof's UI runtime has no tab/visibility widget (docs/architecture.md); all
// three laboratories are always on the page, one below another, rather than
// a dynamically shown/hidden tab that would depend on behaviour this
// toolkit does not have.
String comparisonNote(String language) {
    if (isPt(language)) {
        return "As três máquinas reais ficam uma abaixo da outra nesta mesma janela —"
            + " role a página para ver o 8051 e o Cortex-M3."
    }
    return "All three real machines sit one below another in this same window —"
        + " scroll down for the 8051 and the Cortex-M3."
}

// --- phase 11 stage B: the comparison view ---

String compareTitle(String language) {
    if (isPt(language)) { return "COMPARAÇÃO ENTRE ARQUITETURAS" }
    return "ARCHITECTURE COMPARISON"
}

String compareSetLabel(String language) {
    if (isPt(language)) { return "PROGRAMA" }
    return "PROGRAM"
}

String compareStepAllButton(String language) {
    if (isPt(language)) { return "Passo (as três)" }
    return "Step (all three)"
}

String comparePubvmLabel(String language) {
    return "PubVM-8"
}

String compare8051Label(String language) {
    return "8051"
}

String compareM3Label(String language) {
    return "Cortex-M3"
}
