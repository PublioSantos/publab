package publab.ui

import publab.machine
import publab.assembler
import publab.app

// The laboratory's controller. It owns the one real machine the interface
// observes, and it is the only place the interface is allowed to change it.
//
// The state lives in static fields because a Kof lambda captures a read-only
// snapshot of its environment: a click handler that closed over a `Machine`
// variable would be acting on a copy frozen at build time. Reaching the
// machine through these functions means every button acts on the real one.
//
// Nothing here renders. That is what lets the whole controller be tested on
// the JVM as well as on JS, even though widgets only draw on JS.

class Lab {
    static Machine machine = Machine(pubvm8())
    static MachineConfig config = pubvm8()
    static String language = "en"
    static String diagnostics = ""
    static String message = ""
    static Bool assembled = false
    static Int imageBytes = 0

    // Debugger state (phase 6). `previous` is the reading from just before the
    // last control acted, which is what lets the interface show what the last
    // instruction changed instead of only where the machine ended up.
    static MachineState previous = Machine(pubvm8()).snapshot()
    static List<Int> previousMemory = emptyIntList()
    static Int previousMemoryBase = 0
    static List<SourceMapEntry> sourceMap = emptySourceMap()
    static String assembledSource = ""
    static String memoryMode = "HEX"
}

// A run from the interface must end. A program can loop forever, and a
// browser tab that never returns is not a laboratory.
Int labRunBudget() {
    return 200000
}

MachineConfig labConfig() {
    return Lab.config
}

String labLanguage() {
    return Lab.language
}

String labDiagnostics() {
    return Lab.diagnostics
}

String labMessage() {
    return Lab.message
}

Bool labAssembled() {
    return Lab.assembled
}

Int labImageBytes() {
    return Lab.imageBytes
}

// The complete, immutable reading the interface renders from.
MachineState labState() {
    return Lab.machine.snapshot()
}

List<String> labMachineNames() {
    var names: List<String> = listOf()
    for (var machine in allMachines()) { names.add(machine.name()) }
    return names
}

List<String> labExampleNames() {
    return exampleNames()
}

String labExampleSource(Int index) {
    var safe = index
    if (safe < 0) { safe = 0 }
    if (safe >= examplePrograms().size) { safe = 0 }
    return examplePrograms().get(safe).source()
}

String labDefaultSource() {
    return defaultExampleSource()
}

void labSetLanguage(String language) {
    Lab.language = language
    // The standing message was written in the previous language; re-derive it
    // from the machine so the whole window speaks one language.
    Lab.message = currentStateMessage(Lab.machine.snapshot(), Lab.assembled,
        Lab.imageBytes, language)
}

// Switching machine discards whatever was loaded: an image is encoded for one
// word size — the immediates have that width — so it is not transferable.
void labSelectMachine(Int index) {
    var safe = index
    if (safe < 0) { safe = 0 }
    if (safe >= allMachines().size) { safe = 0 }
    Lab.config = allMachines().get(safe)
    Lab.machine = Machine(Lab.config)
    Lab.assembled = false
    Lab.imageBytes = 0
    Lab.diagnostics = ""
    Lab.sourceMap = emptySourceMap()
    Lab.assembledSource = ""
    Lab.message = notAssembledMessage(Lab.language)
    labForgetChanges()
}

Int labSelectedMachine() {
    var index = 0
    var i = 0
    for (var machine in allMachines()) {
        if (machine.name() == Lab.config.name()) { index = i }
        i = i + 1
    }
    return index
}

// --- debugger reads (phase 6) ----------------------------------------------

// The reading from just before the last control acted.
MachineState labPreviousState() {
    return Lab.previous
}

List<SourceMapEntry> labSourceMap() {
    return Lab.sourceMap
}

// The source the loaded image was assembled from — not the editor's current
// text, which may have been edited since.
String labAssembledSource() {
    return Lab.assembledSource
}

String labMemoryMode() {
    return Lab.memoryMode
}

void labSetMemoryMode(String mode) {
    Lab.memoryMode = mode
}

// The dump follows PC, aligned to the window size.
Int labMemoryBase() {
    return memoryWindowBaseFor(Lab.machine.pc)
}

List<Int> labMemoryWindowAt(Int base) {
    var window: List<Int> = listOf()
    var offset = 0
    while (offset < memoryWindowSize()) {
        val address = base + offset
        if (address < Lab.config.memorySize()) {
            window.add(Lab.machine.memory.readByte(address))
        }
        offset = offset + 1
    }
    return window
}

List<Int> labMemoryWindow() {
    return labMemoryWindowAt(labMemoryBase())
}

// Only comparable when it came from the same window: otherwise the dump would
// mark cells as changed by comparing two different regions of memory.
List<Int> labPreviousMemoryWindow() {
    if (Lab.previousMemoryBase == labMemoryBase()) {
        return Lab.previousMemory
    }
    return emptyIntList()
}

// Where in the source the machine is, through the assembler's source map.
String labSourceLine() {
    return sourceLineView(Lab.sourceMap, Lab.machine.pc, Lab.assembledSource, Lab.language)
}

// --- the educational layer (phase 7) ----------------------------------------
//
// What the last Step or Run did, in plain language, built from the reading
// the controller kept from right before it acted. Reads the same `previous`
// state the debugger's change list reads, so Step and the explanation always
// describe the same instruction.
String labExplanation() {
    if (!Lab.assembled) { return noExplainYet(Lab.language) }
    return instructionExplanation(Lab.previous, Lab.machine.snapshot(), Lab.language)
}

// Called before a control acts, so that afterwards the interface can show the
// difference the instruction made.
void labRemember() {
    Lab.previous = Lab.machine.snapshot()
    Lab.previousMemoryBase = labMemoryBase()
    Lab.previousMemory = labMemoryWindowAt(Lab.previousMemoryBase)
}

// Used when there is nothing to compare against — after Assemble, Reset or a
// machine change, where marking every cell as "changed" would be noise.
void labForgetChanges() {
    Lab.previous = Lab.machine.snapshot()
    Lab.previousMemoryBase = labMemoryBase()
    Lab.previousMemory = labMemoryWindowAt(Lab.previousMemoryBase)
}

// --- controls ---------------------------------------------------------------

// Assembles the editor's text for the selected machine and, when it is clean,
// loads the image. A failed assembly leaves an empty machine on purpose: a
// program that did not assemble must never appear to be running.
Bool labAssemble(String source) {
    val result = assembleSource(source, Lab.config)
    Lab.diagnostics = renderDiagnostics(result.diagnostics(), Lab.language)
    Lab.machine = Machine(Lab.config)
    if (result.ok()) {
        Lab.machine.load(result.image())
        Lab.assembled = true
        Lab.imageBytes = result.byteCount()
        Lab.sourceMap = result.sourceMap()
        Lab.assembledSource = source
        Lab.message = assembledMessage(result.byteCount(), Lab.language)
    } else {
        Lab.assembled = false
        Lab.imageBytes = 0
        Lab.sourceMap = emptySourceMap()
        Lab.assembledSource = ""
        Lab.message = assemblyFailedMessage(Lab.language)
    }
    labForgetChanges()
    return result.ok()
}

// Back to the state right after Assemble: memory rewritten from the image,
// registers, flags, output and cycles cleared.
void labReset() {
    Lab.machine.reset()
    if (Lab.assembled) {
        Lab.message = assembledMessage(Lab.imageBytes, Lab.language)
    } else {
        Lab.message = notAssembledMessage(Lab.language)
    }
    labForgetChanges()
}

Bool labStep() {
    if (!Lab.assembled) {
        Lab.message = notAssembledMessage(Lab.language)
        return false
    }
    labRemember()
    val executed = Lab.machine.step()
    Lab.message = stepMessage(Lab.machine.snapshot(), Lab.language)
    return executed
}

Int labRun() {
    if (!Lab.assembled) {
        Lab.message = notAssembledMessage(Lab.language)
        return 0
    }
    labRemember()
    val cycles = Lab.machine.run(labRunBudget())
    Lab.message = runMessage(Lab.machine.snapshot(), Lab.language)
    return cycles
}
