package tools.serve

import kof.io

// Development server for the built laboratory.
//
// `kof build . --target js` emits index.html plus ES modules, and a browser
// will not load ES modules over file://, so looking at the build needs HTTP.
// This is that, and nothing else — a development tool, not part of PubLab.
//
//   kof build . --target js --output build/ui
//   kof run tools/serve/Main.kf                    # serves ./build/ui
//   kof run tools/serve/Main.kf /abs/path/to/ui    # or an explicit directory
//
// then open http://localhost:8099
//
// Everything is served with `Cache-Control: no-store`, which is the whole
// reason this does not use `serveDir`. The compiler emits only the runtime
// functions the program actually uses, so kof-runtime.mjs changes shape
// between builds; a cached copy from an earlier build makes the page die with
// "does not provide an export named kofUi…" and the error points at the
// runtime instead of at the stale cache. Default.mjs imports the runtime by a
// bare relative path, so a query string on index.html cannot bust it — the
// server has to say no-store.
//
// The laboratory itself does not need this: `kof run Main.kf --target js`
// builds it and opens it in Kof's own webview.
//
// kof check warns MEM014 on `app` (a listening server handle is never closed)
// — the same shape as the official kof.web example; `listen` never returns.

Int serverPort() {
    return 8099
}

String defaultUiDirectory() {
    return "build/ui"
}

// The directory is an argument so that this file carries no machine-specific
// path, and so it can be launched from any working directory.
String uiDirectoryFrom(List<String> args) {
    if (args.size > 0) {
        return args.get(0)
    }
    return defaultUiDirectory()
}

String contentTypeFor(String name) {
    if (name.endsWith(".html")) { return "text/html; charset=utf-8" }
    if (name.endsWith(".mjs")) { return "text/javascript; charset=utf-8" }
    if (name.endsWith(".js")) { return "text/javascript; charset=utf-8" }
    if (name.endsWith(".map")) { return "application/json; charset=utf-8" }
    if (name.endsWith(".json")) { return "application/json; charset=utf-8" }
    if (name.endsWith(".css")) { return "text/css; charset=utf-8" }
    return "text/plain; charset=utf-8"
}

// The build is a flat directory, so a name with a separator or a parent
// reference is never legitimate here.
Bool isServableName(String name) {
    if (name.length == 0) { return false }
    if (name.contains("..")) { return false }
    if (name.contains("/")) { return false }
    return true
}

main(args: List<String>) {
    val directory = uiDirectoryFrom(args)
    var app = web.app()

    app.get("/") {
        headerSet("Content-Type", "text/html; charset=utf-8")
        headerSet("Cache-Control", "no-store")
        String? page = File(directory + "/index.html").readText()
        if (page != null) {
            return page
        }
        return null
    }

    app.get("/:file") {
        val name = param("file")
        if (isServableName(name)) {
            headerSet("Content-Type", contentTypeFor(name))
            headerSet("Cache-Control", "no-store")
            String? body = File(directory + "/" + name).readText()
            if (body != null) {
                return body
            }
        }
        return null
    }

    println("PubLab build served at http://localhost:" + serverPort()
        + " from " + directory + " (no-store)")
    app.listen(serverPort())
}
