package kofplab.machine

// Word-size arithmetic — the single place where KofVM's word width is applied.
// Every value the machine stores passes through here, so an 8-, 16- or 32-bit
// machine is a parameter, never a separate implementation.
//
// Values are carried in a Long (64-bit) so that an unsigned 32-bit word
// (0..4294967295) still fits without losing information.

// Highest bit pattern representable in `wordSize` bits: 8 -> 255.
Long wordMask(Int wordSize) {
    var m: Long = 1 as Long
    m = m << wordSize
    return m - (1 as Long)
}

// The sign bit of the word: 8 -> 128.
Long wordSignBit(Int wordSize) {
    var m: Long = 1 as Long
    return m << (wordSize - 1)
}

// How many memory bytes one word occupies.
Int wordBytes(Int wordSize) {
    return wordSize / 8
}

// Truncate a value to the word: 270 in 8 bits -> 14; -6 in 8 bits -> 250.
Long wordWrap(Long value, Int wordSize) {
    return value & wordMask(wordSize)
}

// True when the stored word has its sign bit set (flag N).
Bool wordIsNegative(Long value, Int wordSize) {
    return (wordWrap(value, wordSize) & wordSignBit(wordSize)) != (0 as Long)
}

// Reading the stored word as two's complement: 250 in 8 bits -> -6.
Long wordToSigned(Long value, Int wordSize) {
    val stored = wordWrap(value, wordSize)
    if (wordIsNegative(stored, wordSize)) {
        return stored - (wordMask(wordSize) + (1 as Long))
    }
    return stored
}

Long wordMaxUnsigned(Int wordSize) {
    return wordMask(wordSize)
}

Long wordMaxSigned(Int wordSize) {
    return wordSignBit(wordSize) - (1 as Long)
}

Long wordMinSigned(Int wordSize) {
    return (0 as Long) - wordSignBit(wordSize)
}

String hexAlphabet() {
    return "0123456789ABCDEF"
}

// Zero-padded hexadecimal with a fixed number of digits.
String toHex(Long value, Int digits) {
    var v = value
    var out = ""
    var i = 0
    while (i < digits) {
        val nibble = ((v & (15 as Long)) as Int)
        out = hexAlphabet().substring(nibble, nibble + 1) + out
        v = v >>> 4
        i++
    }
    return out
}

// Zero-padded binary with a fixed number of bits.
String toBin(Long value, Int bits) {
    var v = value
    var out = ""
    var i = 0
    while (i < bits) {
        if ((v & (1 as Long)) == (1 as Long)) {
            out = "1" + out
        } else {
            out = "0" + out
        }
        v = v >>> 1
        i++
    }
    return out
}

// A word rendered the way the laboratory shows a register.
String wordToHex(Long value, Int wordSize) {
    return toHex(wordWrap(value, wordSize), wordBytes(wordSize) * 2)
}

String wordToBin(Long value, Int wordSize) {
    return toBin(wordWrap(value, wordSize), wordSize)
}
