package tests

import kof.io
import publab.machine
import publab.assembler

// The examples are not illustrations: each one is assembled, executed and
// checked here (section 39 of the specification).

record ExampleRun(Bool ok, List<String> output, String report)

ExampleRun runExample(String path) {
    String? source = File(path).readText()
    if (source != null) {
        val assembled = assembleSource(source, pubvm8())
        if (!assembled.ok()) {
            return ExampleRun(false, emptyStringList(),
                "did not assemble:\n" + renderDiagnostics(assembled.diagnostics(), "en"))
        }
        var machine = Machine(pubvm8())
        machine.load(assembled.image())
        machine.run(1000)
        if (statusName(machine.status) != "HALTED") {
            return ExampleRun(false, machine.output,
                "did not halt: " + statusName(machine.status) + " " + machine.errorMessage)
        }
        return ExampleRun(true, machine.output, "")
    }
    return ExampleRun(false, emptyStringList(), "could not read " + path)
}

String joinOutput(List<String> output) {
    var out = ""
    for (var line in output) {
        if (out.length > 0) { out = out + "," }
        out = out + line
    }
    return out
}

void checkExample(String name, String expectedOutput) {
    val run = runExample("examples/" + name)
    assert(run.ok(), name + ": " + run.report())
    assert(joinOutput(run.output()) == expectedOutput,
        name + ": expected output [" + expectedOutput + "] but got ["
            + joinOutput(run.output()) + "]")
}

test "hello.pasm" {
    checkExample("hello.pasm", "1")
}

test "addition.pasm" {
    checkExample("addition.pasm", "30")
}

test "overflow.pasm prints 14 on PubVM-8" {
    checkExample("overflow.pasm", "14")
}

test "loops.pasm counts down" {
    checkExample("loops.pasm", "3,2,1,0")
}

test "memory.pasm round-trips through memory" {
    checkExample("memory.pasm", "42")
}

test "memory.pasm really leaves 42 at address 0x80" {
    String? source = File("examples/memory.pasm").readText()
    if (source != null) {
        val assembled = assembleSource(source, pubvm8())
        assert(assembled.ok())
        var machine = Machine(pubvm8())
        machine.load(assembled.image())
        machine.run(1000)
        assert(machine.memory.readByte(128) == 42)
    }
}

test "overflow.pasm gives the documented answer on all three variants" {
    // The comment inside the example promises 14 / 270 / 270. This holds it
    // to that promise on the real machines.
    String? source = File("examples/overflow.pasm").readText()
    if (source != null) {
        var expected = listOf("14")
        expected.add("270")
        expected.add("270")
        var index = 0
        for (var config in allMachines()) {
            val assembled = assembleSource(source, config)
            assert(assembled.ok(), config.name() + ": "
                + renderDiagnostics(assembled.diagnostics(), "en"))
            var machine = Machine(config)
            machine.load(assembled.image())
            machine.run(1000)
            assert(statusName(machine.status) == "HALTED", config.name())
            assert(machine.output.get(0) == expected.get(index),
                config.name() + ": expected " + expected.get(index)
                    + " but printed " + machine.output.get(0))
            assert(machine.flags.carry == (config.wordSize() == 8),
                config.name() + ": carry only on the 8-bit variant")
            index = index + 1
        }
    }
}
