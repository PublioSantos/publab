package tests

import kof.io
import kofplab.machine
import kofplab.assembler

// The examples are not illustrations: each one is assembled, executed and
// checked here (section 39 of the specification).

record ExampleRun(Bool ok, List<String> output, String report)

ExampleRun runExample(String path) {
    String? source = File(path).readText()
    if (source != null) {
        val assembled = assembleSource(source, kofvm8())
        if (!assembled.ok()) {
            return ExampleRun(false, emptyStringList(),
                "did not assemble:\n" + renderDiagnostics(assembled.diagnostics(), "en"))
        }
        var machine = Machine(kofvm8())
        machine.load(assembled.image())
        machine.run(1000)
        if (statusName(machine.status) != "HALTED") {
            return ExampleRun(false, machine.output,
                "did not halt: " + statusName(machine.status) + " " + machine.errorMessage)
        }
        return ExampleRun(true, machine.output, "")
    }
    return ExampleRun(false, emptyStringList(), "could not read " + path)
}

String joinOutput(List<String> output) {
    var out = ""
    for (var line in output) {
        if (out.length > 0) { out = out + "," }
        out = out + line
    }
    return out
}

void checkExample(String name, String expectedOutput) {
    val run = runExample("examples/" + name)
    assert(run.ok(), name + ": " + run.report())
    assert(joinOutput(run.output()) == expectedOutput,
        name + ": expected output [" + expectedOutput + "] but got ["
            + joinOutput(run.output()) + "]")
}

test "hello.kasm" {
    checkExample("hello.kasm", "1")
}

test "addition.kasm" {
    checkExample("addition.kasm", "30")
}

test "overflow.kasm prints 14 on KofVM-8" {
    checkExample("overflow.kasm", "14")
}

test "loops.kasm counts down" {
    checkExample("loops.kasm", "3,2,1,0")
}

test "memory.kasm round-trips through memory" {
    checkExample("memory.kasm", "42")
}

test "memory.kasm really leaves 42 at address 0x80" {
    String? source = File("examples/memory.kasm").readText()
    if (source != null) {
        val assembled = assembleSource(source, kofvm8())
        assert(assembled.ok())
        var machine = Machine(kofvm8())
        machine.load(assembled.image())
        machine.run(1000)
        assert(machine.memory.readByte(128) == 42)
    }
}
