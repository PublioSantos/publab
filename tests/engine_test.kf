package tests

import kofplab.machine

// Phase 1 proves the machine on its own: these programs are hand-encoded
// byte by byte, with no assembler involved.
//
//   LOAD A, 250   10 00 FA
//   LOAD B, 20    10 01 14
//   ADD  A, B     21 00 01
//   PRINT A       60 00
//   HALT          00

List<Int> goldenImage() {
    return listOf(0x10, 0x00, 250, 0x10, 0x01, 20, 0x21, 0x00, 0x01, 0x60, 0x00, 0x00)
}

Machine loadedKofvm8(List<Int> image) {
    var m = Machine(kofvm8())
    m.load(image)
    return m
}

test "a loaded machine is READY with the program in memory" {
    var m = loadedKofvm8(goldenImage())
    assert(statusName(m.status) == "READY")
    assert(m.pc == 0)
    assert(m.cycles == 0)
    assert(m.memory.readByte(0) == 0x10, "the program really is in memory")
    assert(m.memory.readByte(2) == 250)
    assert(m.currentInstructionText() == "LOAD A, 250")
}

test "step executes exactly one instruction" {
    var m = loadedKofvm8(goldenImage())
    assert(m.step())
    assert(m.registers.read(0) == 250 as Long, "A = 250")
    assert(m.registers.read(1) == 0 as Long, "B untouched")
    assert(m.pc == 3, "PC advanced by the instruction length")
    assert(m.cycles == 1)
    assert(statusName(m.status) == "PAUSED")
    assert(m.currentInstructionText() == "LOAD B, 20")
}

test "LOAD does not change the flags" {
    var m = loadedKofvm8(goldenImage())
    m.step()
    assert(m.flags.carry == false && m.flags.zero == false)
    assert(m.flags.negative == false && m.flags.overflow == false)
}

test "the ADD of the golden test, step by step, on KofVM-8" {
    var m = loadedKofvm8(goldenImage())
    m.step()
    m.step()
    assert(m.registers.read(0) == 250 as Long)
    assert(m.registers.read(1) == 20 as Long)
    assert(m.currentInstructionText() == "ADD A, B")
    m.step()
    assert(m.registers.read(0) == 14 as Long, "250 + 20 stored in 8 bits is 14")
    assert(m.flags.carry, "C = 1")
    assert(m.flags.zero == false, "Z = 0")
    assert(m.flags.negative == false, "N = 0")
    assert(m.flags.overflow == false, "O = 0")
    assert(m.pc == 9)
}

test "PRINT writes to the educational output and HALT stops the machine" {
    var m = loadedKofvm8(goldenImage())
    val executed = m.run(100)
    assert(executed == 5, "five instructions")
    assert(statusName(m.status) == "HALTED")
    assert(m.output.size == 1)
    assert(m.output.get(0) == "14")
    assert(m.pc == 11, "PC stays on the HALT instruction")
    assert(m.currentInstructionText() == "HALT")
}

test "a halted machine does not step again" {
    var m = loadedKofvm8(goldenImage())
    m.run(100)
    assert(m.cycles == 5)
    assert(m.step() == false)
    assert(m.cycles == 5, "no cycle was consumed")
}

test "reset restores the machine and keeps the program" {
    var m = loadedKofvm8(goldenImage())
    m.run(100)
    m.reset()
    assert(statusName(m.status) == "READY")
    assert(m.pc == 0)
    assert(m.cycles == 0)
    assert(m.registers.read(0) == 0 as Long)
    assert(m.output.size == 0)
    assert(m.flags.carry == false)
    assert(m.memory.readByte(0) == 0x10, "the program is still loaded")
    assert(m.run(100) == 5, "and it runs again")
}

test "reset also undoes what the program wrote to memory" {
    //   LOAD A, 7      10 00 07
    //   STORE [32], A  18 20 00 00
    //   HALT           00
    var m = loadedKofvm8(listOf(0x10, 0x00, 7, 0x18, 0x20, 0x00, 0x00, 0x00))
    m.run(100)
    assert(m.memory.readByte(32) == 7)
    m.reset()
    assert(m.memory.readByte(32) == 0, "memory written by the program is cleared")
}

test "LOAD from memory and STORE to memory" {
    //   LOAD A, 200     10 00 C8
    //   STORE [64], A   18 40 00 00
    //   LOAD B, [64]    12 01 40 00
    //   HALT            00
    var m = loadedKofvm8(listOf(0x10, 0x00, 200, 0x18, 0x40, 0x00, 0x00,
                                0x12, 0x01, 0x40, 0x00, 0x00))
    m.run(100)
    assert(statusName(m.status) == "HALTED")
    assert(m.memory.readByte(64) == 200)
    assert(m.registers.read(1) == 200 as Long, "B came back from memory")
}

test "JMP, JZ taken and JZ not taken" {
    //   LOAD A, 1      10 00 01
    //   SUB  A, 1      28 00 01     -> A = 0, Z = 1
    //   JZ   10        51 0A 00     -> taken, jumps to 0x0A
    //   PRINT A        60 00        (skipped)
    //   HALT           00           at 0x0A
    var taken = loadedKofvm8(listOf(0x10, 0x00, 1, 0x28, 0x00, 1, 0x51, 0x09, 0x00, 0x00, 0x60, 0x00))
    taken.run(100)
    assert(statusName(taken.status) == "HALTED")
    assert(taken.output.size == 0, "the PRINT after the HALT never ran")
    assert(taken.pc == 9)

    //   LOAD A, 5      10 00 05
    //   SUB  A, 1      28 00 01     -> A = 4, Z = 0
    //   JZ   09        51 09 00     -> not taken
    //   PRINT A        60 00
    //   HALT           00
    var notTaken = loadedKofvm8(listOf(0x10, 0x00, 5, 0x28, 0x00, 1, 0x51, 0x0C, 0x00, 0x60, 0x00, 0x00))
    notTaken.run(100)
    assert(notTaken.output.size == 1, "execution fell through to the PRINT")
    assert(notTaken.output.get(0) == "4")
}

test "JC jumps on carry" {
    //   LOAD A, 250    10 00 FA
    //   ADD  A, 20     20 00 14     -> C = 1
    //   JC   0C        52 0C 00     -> taken (to the HALT at 0x0C)
    //   PRINT A        60 00
    //   HALT           00
    var m = loadedKofvm8(listOf(0x10, 0x00, 250, 0x20, 0x00, 20, 0x52, 0x0C, 0x00, 0x60, 0x00, 0x00, 0x00))
    m.run(100)
    assert(m.flags.carry)
    assert(m.pc == 12, "jumped over the PRINT")
    assert(m.output.size == 0)
}

test "the cycle budget stops an endless loop instead of hanging" {
    //   JMP 0          50 00 00
    var m = loadedKofvm8(listOf(0x50, 0x00, 0x00))
    val executed = m.run(50)
    assert(executed == 50, "the budget bounded the run")
    assert(statusName(m.status) == "PAUSED", "PAUSED means it did not finish")
    assert(m.canRun(), "and it can be resumed")
    assert(m.run(10) == 10)
}

test "an unknown opcode is an ERROR with a message, not a crash" {
    var m = loadedKofvm8(listOf(0xEE, 0x00))
    assert(m.step() == false)
    assert(statusName(m.status) == "ERROR")
    assert(m.errorMessage.contains("unknown opcode"))
    assert(m.errorMessage.contains("0xEE"))
    assert(m.canRun() == false)
}

test "an out-of-range memory access is an ERROR" {
    //   LOAD A, [0xFFFF] reads one byte at the last address: valid.
    //   STORE [0xFFFF], A with a 16-bit word would run off the end, but
    //   KofVM-8 words are one byte, so instead force the fault with a
    //   machine whose memory is smaller than the address operand.
    var small = Machine(MachineConfig("KofVM-8/tiny", 8, 64, 16, 0))
    small.load(listOf(0x12, 0x00, 0x00, 0x02, 0x00))
    assert(small.step() == false)
    assert(statusName(small.status) == "ERROR")
    assert(small.errorMessage.contains("out of range"))
}

test "halt() stops the machine from the outside" {
    var m = loadedKofvm8(goldenImage())
    m.step()
    m.halt()
    assert(statusName(m.status) == "HALTED")
    assert(m.step() == false)
}

test "requestPause stops a run at an instruction boundary" {
    var m = loadedKofvm8(listOf(0x50, 0x00, 0x00))
    m.requestPause()
    assert(m.run(1000) == 0, "the pending pause stopped the run before any cycle")
    assert(statusName(m.status) == "PAUSED")
    // The request was consumed: the next run proceeds normally.
    assert(m.run(10) == 10)
    assert(m.cycles == 10)
}

test "snapshot reports the real state" {
    var m = loadedKofvm8(goldenImage())
    m.run(100)
    val s = m.snapshot()
    assert(s.machineName() == "KofVM-8")
    assert(s.wordSize() == 8)
    assert(s.registerNames().get(0) == "A")
    assert(s.registers().get(0) == 14 as Long)
    assert(s.registers().get(1) == 20 as Long)
    assert(s.carry() && s.zero() == false)
    assert(s.pc() == 11)
    assert(s.cycles() == 5)
    assert(statusName(s.status()) == "HALTED")
    assert(s.output().get(0) == "14")
    assert(s.currentInstruction() == "HALT")
}

test "a snapshot does not change when the machine moves on" {
    var m = loadedKofvm8(goldenImage())
    m.run(100)
    val before = m.snapshot()
    m.reset()
    assert(before.output().size == 1, "the snapshot kept its own output")
    assert(m.output.size == 0)
}

test "the disassembler reads back every operand form" {
    var m = loadedKofvm8(listOf(0x48, 0x02))
    assert(m.currentInstructionText() == "NOT C")
    var j = loadedKofvm8(listOf(0x50, 0x34, 0x12))
    assert(j.currentInstructionText() == "JMP 0x1234")
    var s = loadedKofvm8(listOf(0x18, 0x10, 0x00, 0x03))
    assert(s.currentInstructionText() == "STORE [0x0010], D")
    var l = loadedKofvm8(listOf(0x12, 0x01, 0x20, 0x00))
    assert(l.currentInstructionText() == "LOAD B, [0x0020]")
}
