package tests

import publab.machine
import publab.assembler
import publab.ui

// Phase 8, stage C — SHL, SHR, ROL, ROR, and the remaining conditional
// jumps JN, JO, JNZ, JNC. Advanced Mode is now complete.

Machine loaded(String source, MachineConfig config) {
    val assembled = assembleSource(source, config)
    assert(assembled.ok(), renderDiagnostics(assembled.diagnostics(), "en"))
    var m = Machine(config)
    m.load(assembled.image())
    return m
}

// --- ALU: SHL --------------------------------------------------------------

test "aluShl shifts left, zero-filled, carry is the bit that left" {
    val r1 = aluShl(1 as Long, 1 as Long, 8)
    assert(r1.value() == 2 as Long && r1.carry() == false)
    val r2 = aluShl(0x80 as Long, 1 as Long, 8) // 10000000
    assert(r2.value() == 0 as Long, "shifted out entirely, zero-filled")
    assert(r2.carry(), "the bit that left was 1")
    assert(r2.zero())
    val r3 = aluShl(0x81 as Long, 1 as Long, 8) // 10000001 -> 00000010, carry 1
    assert(r3.value() == 2 as Long && r3.carry())
}

test "aluShl: count 0 is a no-op, count >= wordSize empties the register" {
    val noop = aluShl(42 as Long, 0 as Long, 8)
    assert(noop.value() == 42 as Long && noop.carry() == false)
    val emptied = aluShl(0xFF as Long, 8 as Long, 8)
    assert(emptied.value() == 0 as Long && emptied.carry() == false)
    val wayPast = aluShl(0xFF as Long, 99 as Long, 8)
    assert(wayPast.value() == 0 as Long && wayPast.carry() == false)
}

// --- ALU: SHR --------------------------------------------------------------

test "aluShr shifts right, zero-filled (unsigned), carry is the bit that left" {
    val r1 = aluShr(2 as Long, 1 as Long, 8)
    assert(r1.value() == 1 as Long && r1.carry() == false)
    val r2 = aluShr(1 as Long, 1 as Long, 8)
    assert(r2.value() == 0 as Long && r2.carry(), "the only set bit left")
    assert(r2.zero())
    val r3 = aluShr(0xFF as Long, 4 as Long, 8) // 11111111 >> 4 = 00001111, carry 1
    assert(r3.value() == 0x0F as Long && r3.carry())
}

test "aluShr never sign-extends, even when the sign bit is set" {
    val r = aluShr(0x80 as Long, 1 as Long, 8) // 10000000 >> 1, unsigned
    assert(r.value() == 0x40 as Long, "zero-filled from the top, not sign-extended")
}

test "aluShr: count 0 and count >= wordSize mirror aluShl" {
    val noop = aluShr(42 as Long, 0 as Long, 8)
    assert(noop.value() == 42 as Long && noop.carry() == false)
    val emptied = aluShr(0xFF as Long, 8 as Long, 8)
    assert(emptied.value() == 0 as Long && emptied.carry() == false)
}

// --- ALU: ROL / ROR ----------------------------------------------------------

test "aluRol wraps the top bit around to the bottom" {
    val r = aluRol(0x81 as Long, 1 as Long, 8) // 10000001 rol 1 = 00000011
    assert(r.value() == 0x03 as Long, "" + r.value())
    assert(r.carry(), "the bit that wrapped around was 1")
}

test "aluRor wraps the bottom bit around to the top" {
    val r = aluRor(0x81 as Long, 1 as Long, 8) // 10000001 ror 1 = 11000000
    assert(r.value() == 0xC0 as Long, "" + r.value())
    assert(r.carry(), "the bit that wrapped around was 1")
}

test "rotating by a whole word is the identity, and count is taken modulo wordSize" {
    val full = aluRol(0x3C as Long, 8 as Long, 8)
    assert(full.value() == 0x3C as Long, "rotating by 8 on an 8-bit word changes nothing")
    assert(full.carry() == false)
    val wrapped = aluRol(0x81 as Long, 9 as Long, 8) // 9 % 8 == 1, same as rol by 1
    assert(wrapped.value() == 0x03 as Long)
}

test "ROL and ROR undo each other" {
    val a = 0x5A as Long
    var i = 1
    while (i < 8) {
        val there = aluRol(a, i as Long, 8)
        val back = aluRor(there.value(), i as Long, 8)
        assert(back.value() == a, "n=" + i)
        i = i + 1
    }
}

// --- flags: Z/N on the stored result, O always cleared ---------------------

test "shifts and rotates set Z and N on the stored result, and clear O" {
    assert(aluShl(0 as Long, 1 as Long, 8).zero())
    assert(aluShl(0x40 as Long, 1 as Long, 8).negative(), "0x40 << 1 == 0x80")
    assert(aluShl(1 as Long, 1 as Long, 8).overflow() == false)
    assert(aluRol(0 as Long, 3 as Long, 8).zero())
    assert(aluRor(0x01 as Long, 1 as Long, 8).negative(), "the wrapped bit becomes the sign bit")
}

// --- the engine, through real programs --------------------------------------

test "SHL reg, imm runs end to end and advances PC" {
    var m = loaded("LOAD A, 1\nSHL A, 3\nHALT\n", pubvm8())
    m.step()
    m.step()
    assert(m.registers.read(0) == 8 as Long)
    assert(statusName(m.status) == "PAUSED")
}

test "SHL reg, reg takes the count from a register, not an immediate" {
    var m = loaded("LOAD A, 1\nLOAD B, 4\nSHL A, B\nHALT\n", pubvm8())
    m.run(1000)
    assert(m.registers.read(0) == 16 as Long)
    assert(m.registers.read(1) == 4 as Long, "the count register itself is untouched")
}

test "SHR, ROL, ROR all exist as real instructions with both operand forms" {
    var m = loaded(
        "LOAD A, 0x80\nSHR A, 4\nLOAD B, 0x81\nROL B, 1\nLOAD C, 0x81\nROR C, 1\nHALT\n",
        pubvm8())
    m.run(1000)
    assert(m.registers.read(0) == 0x08 as Long)
    assert(m.registers.read(1) == 0x03 as Long)
    assert(m.registers.read(2) == 0xC0 as Long)
}

test "shifts and rotates work identically on every word size" {
    for (var config in allMachines()) {
        var m = loaded("LOAD A, 1\nSHL A, 2\nHALT\n", config)
        m.run(1000)
        assert(m.registers.read(0) == 4 as Long, config.name())
    }
}

test "shifts disassemble with the count operand, like ADD" {
    var m = loaded("SHL A, 3\nHALT\n", pubvm8())
    assert(m.currentInstructionText() == "SHL A, 3")
}

// --- the remaining conditional jumps ----------------------------------------

String jumpTestProgram(String mnemonic) {
    return "SUB A, A\n" + mnemonic + " taken\nHALT\ntaken:\nHALT\n"
}

test "JNZ jumps when Z is 0, not when it is 1" {
    // SUB A, A always sets Z (A - A == 0): JNZ must NOT jump here.
    var notTaken = loaded(jumpTestProgram("JNZ"), pubvm8())
    notTaken.step()
    assert(notTaken.flags.zero)
    notTaken.step()
    assert(notTaken.pc == 6, "fell through to the first HALT, right after JNZ")

    var taken = loaded("LOAD A, 1\nJNZ skip\nHALT\nskip:\nHALT\n", pubvm8())
    taken.step()
    assert(taken.flags.zero == false)
    taken.step()
    assert(statusName(taken.status) != "ERROR")
    taken.step()
    assert(statusName(taken.status) == "HALTED", "jumped past the first HALT")
}

test "JNC jumps when C is 0, not when it is 1" {
    var notTaken = loaded("LOAD A, 3\nLOAD B, 10\nSUB A, B\nJNC skip\nHALT\nskip:\nHALT\n", pubvm8())
    notTaken.run(1000)
    assert(statusName(notTaken.status) == "HALTED")
    // 3 - 10 borrows (C=1), so JNC must NOT have jumped: the machine halts
    // at the FIRST HALT, having executed all 5 instructions in sequence.
    assert(notTaken.cycles == 5, "" + notTaken.cycles)
}

test "JN jumps when N is 1 (the stored result is negative)" {
    var m = loaded("LOAD A, 3\nLOAD B, 10\nSUB A, B\nJN taken\nHALT\ntaken:\nHALT\n", pubvm8())
    m.step()
    m.step()
    m.step()
    assert(m.flags.negative, "3 - 10 wraps to a value with the sign bit set")
    m.step()
    assert(m.pc == 13, "jumped to 'taken', past the first HALT")
}

test "JO jumps when O is 1 (signed overflow)" {
    // 100 + 100 overflows signed 8-bit (both positive, result negative).
    var m = loaded("LOAD A, 100\nLOAD B, 100\nADD A, B\nJO taken\nHALT\ntaken:\nHALT\n", pubvm8())
    m.step()
    m.step()
    m.step()
    assert(m.flags.overflow)
    m.step()
    assert(m.pc == 13)
}

test "all four new jumps touch no flag themselves" {
    var m = loaded("LOAD A, 1\nJNZ skip\nskip:\nHALT\n", pubvm8())
    m.step()
    val z = m.flags.zero
    val c = m.flags.carry
    val n = m.flags.negative
    val o = m.flags.overflow
    m.step()
    assert(m.flags.zero == z && m.flags.carry == c)
    assert(m.flags.negative == n && m.flags.overflow == o)
}

// --- the educational layer explains the new instructions too ---------------

test "PUSH, POP, CALL, RET, ENTER, LEAVE are explained, not just disassembled" {
    var m = loaded("LOAD A, 5\nPUSH A\nPOP B\nCALL sub\nHALT\nsub:\nENTER\nLEAVE\nRET\n", pubvm8())
    m.step()
    var before = m.snapshot()
    m.step() // PUSH
    var after = m.snapshot()
    assert(instructionExplanation(before, after, "en").contains("PUSH"))

    before = after
    m.step() // POP
    after = m.snapshot()
    assert(instructionExplanation(before, after, "en").contains("POP"))

    before = after
    m.step() // CALL
    after = m.snapshot()
    assert(instructionExplanation(before, after, "en").contains("CALL"))

    before = after
    m.step() // ENTER
    after = m.snapshot()
    assert(instructionExplanation(before, after, "en").contains("ENTER"))

    before = after
    m.step() // LEAVE
    after = m.snapshot()
    assert(instructionExplanation(before, after, "en").contains("LEAVE"))

    before = after
    m.step() // RET
    after = m.snapshot()
    assert(instructionExplanation(before, after, "en").contains("RET"))
}

test "SHL/SHR/ROL/ROR are explained with the carry bit that crossed the boundary" {
    var m = loaded("LOAD A, 0x80\nSHL A, 1\nHALT\n", pubvm8())
    m.step()
    val before = m.snapshot()
    m.step()
    val after = m.snapshot()
    assert(after.carry())
    val text = instructionExplanation(before, after, "en")
    assert(text.contains("SHL"))
    assert(text.contains("Carry (C) = 1"), text)
    val pt = instructionExplanation(before, after, "pt")
    assert(pt.contains("deslocou"), pt)
}
